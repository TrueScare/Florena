{% extends 'base.html.twig' %}

{% block title %}Leaderboard{% endblock %}

{% block header %}
    {% include 'partials/_app_navbar.html.twig' with { active_page: 'leaderboard' } %}
{% endblock %}

{% block body %}
    {% set firstPlace = scores|length > 0 ? scores[0] : null %}
    {% set secondPlace = scores|length > 1 ? scores[1] : null %}
    {% set thirdPlace = scores|length > 2 ? scores[2] : null %}

    <main class="pt-28 pb-20 px-6 max-w-7xl mx-auto w-full">
        <section class="bg-surface-container-lowest rounded-[3rem] shadow-xl shadow-black/5 p-8 md:p-12 lg:p-16">
            <header class="mb-12">
                <p class="text-primary font-semibold uppercase tracking-[0.25em] text-xs mb-3">
                    Globales Ranking
                </p>

                <h1 class="mb-2 text-4xl font-extrabold tracking-tight text-on-surface">
                    <span class="text-4xl md:text-5xl font-extrabold text-primary tracking-tight mb-2">Leaderboard</span>
                </h1>

                <p class="text-on-surface-variant text-lg max-w-2xl">
                    Sammle Punkte indem du Aufgaben erledigst.
                </p>
            </header>

            {# User Card #}
            {% if app.user %}
                <section class="mb-12 bg-primary-container/20 rounded-[2rem] p-6 md:p-8 ring-2 ring-primary/10">
                    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                        <div class="flex items-center gap-4">
                            <div class="w-16 h-16 rounded-full bg-primary-container flex items-center justify-center text-primary font-headline font-extrabold text-2xl shrink-0">
                                {{ app.user.username|slice(0, 1)|upper }}
                            </div>

                            <div>
                                <p class="text-primary font-semibold uppercase tracking-[0.25em] text-xs mb-2">
                                    Deine Platzierung
                                </p>

                                <h2 class="font-headline text-2xl font-bold text-on-surface">
                                    {{ app.user.username }}
                                </h2>

                                <p class="text-on-surface-variant text-sm">
                                    Dein aktueller Stand im globalen Leaderboard.
                                </p>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4 md:min-w-[340px]">
                            <div class="bg-surface-container-lowest rounded-[1.5rem] p-5 text-center">
                                <p class="text-on-surface-variant text-xs uppercase tracking-widest font-bold mb-2">
                                    Platz
                                </p>

                                <p class="font-headline text-3xl font-extrabold text-primary">
                                    {% if currentUserRank is not null %}
                                        #{{ currentUserRank }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </p>
                            </div>

                            <div class="bg-surface-container-lowest rounded-[1.5rem] p-5 text-center">
                                <p class="text-on-surface-variant text-xs uppercase tracking-widest font-bold mb-2">
                                    Punkte
                                </p>

                                <p class="font-headline text-3xl font-extrabold text-primary">
                                    {{ currentUserScore|default(0)|number_format(0, ',', '.') }}
                                </p>
                            </div>
                        </div>
                    </div>
                </section>
            {% endif %}

            {# Punktesystem #}
            <section class="mb-12 bg-surface-container-low rounded-[2rem] p-6 md:p-8">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                    <div>
                        <p class="text-primary font-semibold uppercase tracking-[0.25em] text-xs mb-3">
                            Punkte-System
                        </p>

                        <h2 class="font-headline text-2xl font-bold text-on-surface mb-2">
                            So sammelst du Punkte
                        </h2>

                        <p class="text-on-surface-variant max-w-2xl">
                            Erledige Pflegeaufgaben für deine eigenen Pflanzen oder unterstütze andere Nutzer bei ihren Aufgaben.
                            Übernommene Aufgaben bringen dir dabei zusätzliche Punkte.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 min-w-full lg:min-w-[420px]">
                        <article class="bg-surface-container-lowest rounded-[1.5rem] p-5 flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-primary-container/40 flex items-center justify-center text-primary shrink-0">
                                <span class="material-symbols-outlined">task_alt</span>
                            </div>

                            <div>
                                <p class="font-headline font-bold text-xl text-on-surface">
                                    +5 Punkte
                                </p>
                                <p class="text-sm text-on-surface-variant">
                                    Für jede erledigte eigene Aufgabe
                                </p>
                            </div>
                        </article>

                        <article class="bg-surface-container-lowest rounded-[1.5rem] p-5 flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-primary-container/40 flex items-center justify-center text-primary shrink-0">
                                <span class="material-symbols-outlined">volunteer_activism</span>
                            </div>

                            <div>
                                <p class="font-headline font-bold text-xl text-on-surface">
                                    +10 Punkte
                                </p>
                                <p class="text-sm text-on-surface-variant">
                                    Für erledigte übernommene Aufgaben
                                </p>
                            </div>
                        </article>
                    </div>
                </div>
            </section>

            {# Leaderboard #}
            {% if scores is empty %}
                <div class="bg-surface-container-low rounded-[2rem] p-10 text-center">
                    <div class="w-16 h-16 rounded-full bg-surface-container mx-auto mb-4 flex items-center justify-center text-on-surface-variant">
                        <span class="material-symbols-outlined text-4xl">leaderboard</span>
                    </div>

                    <h2 class="font-headline text-2xl font-bold text-on-surface mb-2">
                        Noch keine Punkte vorhanden
                    </h2>

                    <p class="text-on-surface-variant">
                        Sobald Aufgaben erledigt wurden, erscheint hier das globale Leaderboard.
                    </p>
                </div>
            {% else %}
                <div class="flex flex-col md:flex-row items-end gap-6 mb-16">
                    {% if secondPlace %}
                        <article class="flex-1 w-full md:w-auto order-2 md:order-1 bg-surface-container-low p-8 rounded-[2rem] flex flex-col items-center text-center border-b-4 border-surface-container-highest">
                            <div class="relative mb-4">
                                <div class="w-20 h-20 rounded-full border-4 border-surface-container-lowest bg-surface-container flex items-center justify-center text-on-surface-variant">
                                    <span class="material-symbols-outlined text-4xl">account_circle</span>
                                </div>

                                <div class="absolute -bottom-2 -right-2 bg-slate-200 text-slate-700 w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shadow-sm">
                                    2
                                </div>
                            </div>

                            <h3 class="font-headline font-bold text-xl mb-1">
                                {{ secondPlace['user'].username }}
                            </h3>

                            <p class="text-primary font-bold">
                                {{ secondPlace['score']|number_format(0, ',', '.') }}
                                <span class="text-xs uppercase tracking-wider opacity-60">Punkte</span>
                            </p>
                        </article>
                    {% endif %}

                    {% if firstPlace %}
                        <article class="flex-1 w-full md:w-auto order-1 md:order-2 bg-primary-container/30 p-10 rounded-[2rem] flex flex-col items-center text-center scale-105 shadow-xl shadow-primary/5 border-b-4 border-primary">
                            <div class="relative mb-6">
                                <div class="w-28 h-28 rounded-full border-4 border-primary-container bg-primary-container/20 flex items-center justify-center text-primary">
                                    <span class="material-symbols-outlined text-6xl">account_circle</span>
                                </div>

                                <div class="absolute -bottom-3 -right-3 bg-tertiary-fixed text-on-tertiary-fixed w-10 h-10 rounded-full flex items-center justify-center font-bold text-lg shadow-md">
                                    <span class="material-symbols-outlined text-lg" style="font-variation-settings: 'FILL' 1;">
                                        workspace_premium
                                    </span>
                                </div>
                            </div>

                            <h3 class="font-headline font-extrabold text-2xl mb-1">
                                {{ firstPlace['user'].username }}
                            </h3>

                            <p class="text-primary font-black text-xl">
                                {{ firstPlace['score']|number_format(0, ',', '.') }}
                                <span class="text-xs uppercase tracking-wider opacity-70">Punkte</span>
                            </p>
                        </article>
                    {% endif %}

                    {% if thirdPlace %}
                        <article class="flex-1 w-full md:w-auto order-3 bg-surface-container-low p-8 rounded-[2rem] flex flex-col items-center text-center border-b-4 border-surface-container-highest">
                            <div class="relative mb-4">
                                <div class="w-20 h-20 rounded-full border-4 border-surface-container-lowest bg-surface-container flex items-center justify-center text-on-surface-variant">
                                    <span class="material-symbols-outlined text-4xl">account_circle</span>
                                </div>

                                <div class="absolute -bottom-2 -right-2 bg-orange-200 text-orange-800 w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm shadow-sm">
                                    3
                                </div>
                            </div>

                            <h3 class="font-headline font-bold text-xl mb-1">
                                {{ thirdPlace['user'].username }}
                            </h3>

                            <p class="text-primary font-bold">
                                {{ thirdPlace['score']|number_format(0, ',', '.') }}
                                <span class="text-xs uppercase tracking-wider opacity-60">Punkte</span>
                            </p>
                        </article>
                    {% endif %}
                </div>

                <section>
                    <div class="px-6 py-2 grid grid-cols-12 text-on-surface-variant text-xs font-bold uppercase tracking-widest">
                        <div class="col-span-2 sm:col-span-1">#</div>
                        <div class="col-span-7 sm:col-span-8">Nutzer</div>
                        <div class="col-span-3 text-right">Punkte</div>
                    </div>

                    <div class="space-y-3">
                        {% for score in scores %}
                            {% set rank = loop.index %}
                            {% set isCurrentUser = app.user and score['user'] == app.user %}

                            <article class="
                                p-4 md:p-5 rounded-[2rem] grid grid-cols-12 items-center transition-colors duration-300
                                {{ isCurrentUser
                                    ? 'bg-primary-container/20 ring-2 ring-primary/20 shadow-lg shadow-primary/5'
                                    : 'bg-surface-container-lowest hover:bg-surface-container-low'
                                }}
                            ">
                                <div class="col-span-2 sm:col-span-1 font-headline font-bold {{ isCurrentUser ? 'text-primary' : 'text-on-surface-variant' }}">
                                    {{ rank }}
                                </div>

                                <div class="col-span-7 sm:col-span-8 flex items-center gap-4">
                                    <div class="
                                        w-10 h-10 rounded-full flex items-center justify-center font-bold shrink-0
                                        {{ isCurrentUser
                                            ? 'bg-primary-container text-primary'
                                            : 'bg-surface-container text-on-surface-variant'
                                        }}
                                    ">
                                        {% if rank == 1 %}
                                            <span class="material-symbols-outlined text-2xl text-primary" style="font-variation-settings: 'FILL' 1;">
                                                workspace_premium
                                            </span>
                                        {% elseif isCurrentUser %}
                                            {{ score['user'].username|slice(0, 1)|upper }}
                                        {% else %}
                                            <span class="material-symbols-outlined text-2xl">account_circle</span>
                                        {% endif %}
                                    </div>

                                    <div class="min-w-0">
                                        <span class="font-semibold text-on-surface truncate block">
                                            {{ score['user'].username }}

                                            {% if isCurrentUser %}
                                                <span class="text-xs font-normal bg-primary/10 text-primary px-2 py-0.5 rounded ml-2">
                                                    Du
                                                </span>
                                            {% endif %}
                                        </span>
                                    </div>
                                </div>

                                <div class="col-span-3 text-right font-bold {{ isCurrentUser ? 'text-primary text-lg' : 'text-primary' }}">
                                    {{ score['score']|number_format(0, ',', '.') }}
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        </section>
    </main>
{% endblock %}
