{% extends 'base.html.twig' %}

{% block title %}Leaderboard{% endblock %}

{% block body %}
    <table>
        <thead>
        <tr>
            <th>Platzierung</th>
            <th>Username</th>
            <th>Score</th>
        </tr>
        </thead>
        <tbody>

        {% for key, score in scores %}
            <tr>
                <td>{{ key + 1 }}</td>
                <td>{{ score['user'].username }}</td>
                <td>{{ score['score'] }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
