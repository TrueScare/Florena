{{ form_start(form, { attr: { class: 'space-y-8' } }) }}

<div class="overflow-hidden rounded-xl bg-surface-container-lowest shadow-[0_20px_40px_rgba(46,52,51,0.06)]">
    <section class="p-8 md:p-12 space-y-10">
        <div class="flex items-center gap-3">
            <span class="rounded-lg bg-primary-container p-2 text-on-primary-container">
                <span class="material-symbols-outlined block">location_on</span>
            </span>
            <h2 class="text-2xl font-bold tracking-tight">Standortinformationen</h2>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
            <div class="space-y-2 md:col-span-2">
                {{ form_label(form.name, null, {
                    label_attr: {
                        class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                    }
                }) }}
                {{ form_widget(form.name, {
                    attr: {
                        class: 'w-full rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface placeholder:text-outline-variant transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                        placeholder: 'z.B. Wohnzimmer Fensterbank'
                    }
                }) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="space-y-2 md:col-span-2">
                {{ form_label(form.description, null, {
                    label_attr: {
                        class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                    }
                }) }}
                {{ form_widget(form.description, {
                    attr: {
                        class: 'w-full resize-none rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface placeholder:text-outline-variant transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                        placeholder: 'Beschreibe kurz diesen Standort...',
                        rows: 4
                    }
                }) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="space-y-2">
                {{ form_label(form.light_condition, null, {
                    label_attr: {
                        class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                    }
                }) }}
                {{ form_widget(form.light_condition, {
                    attr: {
                        class: 'w-full appearance-none rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface transition-all focus:border-primary focus:ring-4 focus:ring-primary/10'
                    }
                }) }}
                {% if form.light_condition.vars.help %}
                    <div class="mt-2 flex items-start gap-2 text-xs leading-relaxed text-on-surface-variant/80">
                        <span class="material-symbols-outlined mt-[1px] text-sm">info</span>
                        <span>{{ form.light_condition.vars.help }}</span>
                    </div>
                {% endif %}
                {{ form_errors(form.light_condition) }}
            </div>

            <div class="space-y-2">
                {{ form_label(form.temperature_level, null, {
                    label_attr: {
                        class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                    }
                }) }}
                {{ form_widget(form.temperature_level, {
                    attr: {
                        class: 'w-full appearance-none rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface transition-all focus:border-primary focus:ring-4 focus:ring-primary/10'
                    }
                }) }}
                {% if form.temperature_level.vars.help %}
                    <div class="mt-2 flex items-start gap-2 text-xs leading-relaxed text-on-surface-variant/80">
                        <span class="material-symbols-outlined mt-[1px] text-sm">info</span>
                        <span>{{ form.temperature_level.vars.help }}</span>
                    </div>
                {% endif %}
                {{ form_errors(form.temperature_level) }}
            </div>

            <div class="space-y-2">
                {{ form_label(form.humidity_level, null, {
                    label_attr: {
                        class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                    }
                }) }}
                {{ form_widget(form.humidity_level, {
                    attr: {
                        class: 'w-full appearance-none rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface transition-all focus:border-primary focus:ring-4 focus:ring-primary/10'
                    }
                }) }}
                {% if form.humidity_level.vars.help %}
                    <div class="mt-2 flex items-start gap-2 text-xs leading-relaxed text-on-surface-variant/80">
                        <span class="material-symbols-outlined mt-[1px] text-sm">info</span>
                        <span>{{ form.humidity_level.vars.help }}</span>
                    </div>
                {% endif %}
                {{ form_errors(form.humidity_level) }}
            </div>
        </div>
    </section>
</div>

<div class="mt-10 flex flex-col items-center justify-end gap-4 md:flex-row">
    <a href="{{ path('app_locations_index') }}"
       class="w-full px-10 py-4 text-center font-bold text-on-surface-variant transition-colors hover:text-on-surface md:w-auto">
        Zurück zur Liste
    </a>

    <button type="submit"
            class="flex w-full items-center justify-center gap-2 rounded-full bg-primary px-12 py-4 font-bold text-on-primary shadow-[0_10px_20px_rgba(61,107,0,0.2)] transition-all active:scale-95 md:w-auto">
        <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">save</span>
        {{ button_label|default('Speichern') }}
    </button>
</div>

{{ form_widget(form._token) }}
{{ form_widget(form.user) }}
{{ form_end(form, { render_rest: false }) }}
