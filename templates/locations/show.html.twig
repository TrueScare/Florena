{% extends 'base.html.twig' %}

{% block title %}Übergabe{% endblock %}

{% block header %}
    {% include 'partials/_app_navbar.html.twig' with { active_page: 'care-for-me' } %}
{% endblock %}

{% block body %}
    {% set task = task_assignment.careTask %}
    {% set ownerName = task.plant.user.displayname ?: task.plant.user.username %}
    {% set fromName = task_assignment.fromUser.displayname ?: task_assignment.fromUser.username %}
    {% set toName = task_assignment.toUser.displayname ?: task_assignment.toUser.username %}

    {% set taskIcon = {
        'gießen': 'water_drop',
        'umtopfen': 'potted_plant',
        'düngen': 'eco'
    }[task.taskType.value|lower] ?? 'assignment' %}

    <main class="max-w-5xl mx-auto px-6 py-12 pt-32 md:py-20">
        <header class="mb-12">
            <div class="mb-8">
                <a href="{{ path('app_task_assignments_index') }}"
                   class="mb-8 inline-flex items-center font-medium text-primary transition-all duration-300 group">
                    <span class="material-symbols-outlined mr-2 text-lg transition-transform group-hover:-translate-x-1">
                        arrow_back
                    </span>
                    <span class="text-sm uppercase tracking-wider">Zurück zu Care for Me</span>
                </a>
            </div>
        </header>

        <div class="bg-surface-container-lowest rounded-xl shadow-[0px_20px_40px_rgba(46,52,51,0.06)] border border-transparent overflow-hidden">
            <div class="p-8 md:p-16 flex flex-col gap-12">

                {# Header #}
                <div class="flex flex-col md:flex-row justify-between items-start gap-6">
                    <div>
                        <h1 class="font-headline text-4xl md:text-5xl font-extrabold tracking-tight text-on-surface mb-2">
                            {{ task.plant.name }}
                        </h1>
                        <p class="text-xs font-bold tracking-[0.2em] text-outline uppercase">
                            Übergabe · {{ task.taskType.value }}
                        </p>
                    </div>

                    <div class="flex items-center gap-3">
                        {% if task_assignment.fromUser == app.user %}
                            <a href="{{ path('app_task_assignments_edit', {'id': task_assignment.id}) }}"
                               class="px-6 py-3 bg-secondary-container text-on-secondary-container rounded-full font-medium text-sm hover:opacity-90 transition-all flex items-center gap-2">
                                <span class="material-symbols-outlined text-lg">edit</span>
                                Bearbeiten
                            </a>
                        {% endif %}

                        {{ include('task_assignments/_delete_form.html.twig') }}
                    </div>
                </div>

                {# Content Grid #}
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

                    {# Preview Card #}
                    <div class="lg:col-span-7 relative group">
                        <div class="absolute -inset-4 bg-primary/5 rounded-xl -rotate-2 -z-10 transition-transform group-hover:rotate-1"></div>

                        <div class="w-full min-h-[420px] rounded-lg bg-surface-container flex flex-col items-center justify-center text-center p-8 shadow-sm">
                            <div class="w-20 h-20 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center mb-4">
                                <span class="material-symbols-outlined text-4xl">{{ taskIcon }}</span>
                            </div>

                            <p class="text-lg font-semibold text-on-surface mb-2">
                                {{ task.plant.name }}
                            </p>

                            <p class="text-sm text-on-surface-variant max-w-md">
                                {{ task.taskType.value|capitalize }} wurde von
                                <span class="font-semibold text-on-surface">{{ fromName }}</span>
                                an
                                <span class="font-semibold text-on-surface">{{ toName }}</span>
                                übergeben.
                            </p>

                            <div class="mt-6 inline-flex items-center gap-2 rounded-full bg-primary-container px-4 py-2 text-sm font-semibold text-on-primary-container">
                                <span class="material-symbols-outlined text-base">person_check</span>
                                Aktiv zugewiesen
                            </div>
                        </div>
                    </div>

                    {# Eigenschaften #}
                    <div class="lg:col-span-5 flex flex-col gap-10">
                        <div class="space-y-6">

                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-xl">calendar_month</span>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-outline uppercase tracking-wider mb-1">
                                        Zeitraum
                                    </p>
                                    <p class="text-on-surface font-semibold text-lg">
                                        {{ task_assignment.startDate|date('d.m.Y H:i') }}
                                    </p>
                                    <p class="text-on-surface-variant text-sm mt-1 italic">
                                        bis {{ task_assignment.endDate|date('d.m.Y H:i') }}
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-surface-container text-on-surface-variant flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-xl">person</span>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-outline uppercase tracking-wider mb-1">
                                        Ursprünglich verantwortlich
                                    </p>
                                    <p class="text-on-surface font-semibold text-lg">{{ ownerName }}</p>
                                    <p class="text-on-surface-variant text-sm mt-1 italic">
                                        Besitzer der Pflanze
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-xl">outgoing_mail</span>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-outline uppercase tracking-wider mb-1">
                                        Übergeben von
                                    </p>
                                    <p class="text-on-surface font-semibold text-lg">{{ fromName }}</p>
                                    <p class="text-on-surface-variant text-sm mt-1 italic">
                                        Person, die die Aufgabe weitergegeben hat
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-tertiary-container text-on-tertiary-container flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-xl">how_to_reg</span>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-outline uppercase tracking-wider mb-1">
                                        Aktuell verantwortlich
                                    </p>
                                    <p class="text-on-surface font-semibold text-lg">{{ toName }}</p>
                                    <p class="text-on-surface-variant text-sm mt-1 italic">
                                        Person, die diese Aufgabe übernimmt
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-full bg-surface-container text-on-surface-variant flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined text-xl">schedule</span>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-outline uppercase tracking-wider mb-1">
                                        Übertragen am
                                    </p>
                                    <p class="text-on-surface font-semibold text-lg">
                                        {{ task_assignment.assignedAt|date('d.m.Y H:i') }}
                                    </p>
                                    <p class="text-on-surface-variant text-sm mt-1 italic">
                                        Zeitpunkt der Übergabe
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                {# Divider #}
                <div class="pt-12 border-t border-surface-container-high"></div>

                {# Notiz / Zusammenfassung #}
                <div class="p-8 bg-surface-container rounded-lg">
                    <h3 class="font-headline font-bold text-lg text-on-surface flex items-center gap-2 mb-4">
                        <span class="material-symbols-outlined">info</span>
                        Übergabe-Zusammenfassung
                    </h3>

                    <p class="text-on-surface-variant text-sm leading-relaxed">
                        Die Aufgabe
                        <span class="font-semibold text-on-surface">{{ task.taskType.value|capitalize }}</span>
                        für
                        <span class="font-semibold text-on-surface">{{ task.plant.name }}</span>
                        ist im Zeitraum von
                        <span class="font-semibold text-on-surface">{{ task_assignment.startDate|date('d.m.Y H:i') }}</span>
                        bis
                        <span class="font-semibold text-on-surface">{{ task_assignment.endDate|date('d.m.Y H:i') }}</span>
                        an
                        <span class="font-semibold text-on-surface">{{ toName }}</span>
                        übergeben.
                    </p>
                </div>

            </div>
        </div>
    </main>
{% endblock %}