<form method="post" action="{{ path('app_locations_delete', {'id': location.id}) }}" onsubmit="return confirm('Bist du dir sicher, dass du den Standort löschen möchtest?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ location.id) }}">
    <button class="btn">Löschen</button>
</form>
