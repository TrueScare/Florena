{% extends 'base.html.twig' %}

{% block title %}Neuen Standort anlegen{% endblock %}

{% block header %}
    {% include 'partials/_app_navbar.html.twig' with { active_page: 'dashboard' } %}
{% endblock %}

{% block body %}
    <main class="mx-auto max-w-5xl px-6 py-16 pt-32 lg:py-24">
        <header class="mb-12">
            <a href="{{ path('app_locations_index') }}"
               class="mb-8 inline-flex items-center font-medium text-primary transition-all duration-300 group">
                <span class="material-symbols-outlined mr-2 text-lg transition-transform group-hover:-translate-x-1">
                    arrow_back
                </span>
                <span class="text-sm uppercase tracking-wider">Zurück zur Übersicht</span>
            </a>

            <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
                <div>
                    <h1 class="mb-4 text-4xl font-extrabold tracking-tight text-on-surface">
                        Neuen Standort <span class="font-bold italic text-primary">anlegen</span>
                    </h1>
                    <p class="max-w-2xl text-lg leading-relaxed text-on-surface-variant">
                        Erfasse die wichtigsten Informationen zu einem Standort, damit Pflanzen später passend zugeordnet werden können.
                    </p>
                </div>
            </div>
        </header>

        {{ include('locations/_form.html.twig') }}
    </main>
{% endblock %}