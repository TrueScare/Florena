{% extends 'base.html.twig' %}

{% block title %}Pflanzen{% endblock %}

{% block header %}
    {% include 'partials/_app_navbar.html.twig' with { active_page: 'dashboard' } %}
{% endblock %}

{% block body %}
    <main class="pt-24 pb-16 px-4 sm:px-8 max-w-5xl mx-auto w-full">

        {# Header Section #}
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
            <div>
                <h1 class="text-4xl md:text-5xl font-extrabold text-primary tracking-tight mb-2">
                    Meine Pflanzen
                </h1>
                <p class="text-secondary text-lg">
                    Hier findest du all deine Pflanzen auf einen Blick.
                </p>
            </div>

            <a href="{{ path('app_plants_new') }}"
               class="flex items-center gap-2 bg-primary text-on-primary px-8 py-4 rounded-full font-bold shadow-[0px_20px_40px_rgba(61,107,0,0.15)] hover:scale-105 active:scale-95 transition-all">
                <span class="material-symbols-outlined">add</span>
                Neue Pflanze
            </a>
        </div>

        <section class="mb-8 rounded-xl bg-surface-container-lowest p-5 shadow-[0px_20px_40px_rgba(46,52,51,0.04)]">
            <form method="get" action="{{ path('app_plants_index') }}" class="flex flex-col gap-4 md:flex-row md:items-center">
                <div class="relative flex-1">
                    <span class="material-symbols-outlined pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">
                        search
                    </span>
                    <input
                        type="text"
                        name="searchTerm"
                        value="{{ paginationResult.searchTerm }}"
                        placeholder="Nach Pflanzenname oder Standort suchen"
                        class="w-full rounded-full border border-transparent bg-surface-container-low px-12 py-4 text-on-surface placeholder:text-outline-variant transition-all focus:border-primary focus:ring-4 focus:ring-primary/10"
                    >
                </div>

                <div class="flex gap-3">
                    <button
                        type="submit"
                        class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-4 font-semibold text-on-primary transition-transform hover:scale-[1.02] active:scale-[0.98]"
                    >
                        Suchen
                    </button>

                    {% if paginationResult.searchTerm %}
                        <a
                            href="{{ path('app_plants_index') }}"
                            class="inline-flex items-center justify-center rounded-full border border-outline-variant/20 px-6 py-4 font-semibold text-on-surface transition-colors hover:border-primary hover:text-primary"
                        >
                            Zurücksetzen
                        </a>
                    {% endif %}
                </div>
            </form>
        </section>

        <div class="space-y-6">
            {% if plants is empty %}
                <div class="bg-white rounded-xl p-6 shadow text-center">
                    {% if paginationResult.searchTerm %}
                        <p class="text-gray-500">
                            Keine Pflanzen für „{{ paginationResult.searchTerm }}“ gefunden.
                        </p>
                    {% else %}
                        <p class="text-gray-500">Du hast noch keine Pflanzen angelegt.</p>
                    {% endif %}
                </div>
            {% else %}
                {% for plant in plants %}
                    {% include 'partials/_plant_card.html.twig' with {
                        plant: {
                            id: plant.id,
                            name: plant.name,
                            botanicalName: plant.botanicalName,
                            imageUrl: plant.displayPhotoPath starts with 'http'
                                ? plant.displayPhotoPath
                                : asset(plant.displayPhotoPath),
                            imageAlt: plant.name,
                            location: plant.location ? plant.location.name : 'Kein Standort',
                            stressLevel: plant.stressScore ?? 100,
                            fitnessStatus: null
                        }
                    } only %}
                {% endfor %}
            {% endif %}
        </div>
    </main>
{% endblock %}
