<form method="post" action="{{ path('app_plants_delete', {'id': plant.id}) }}" onsubmit="return confirm('Bist du dir sicher, dass du die Pflanze löschen möchtest?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plant.id) }}">
    <button class="btn">Löschen</button>
</form>
