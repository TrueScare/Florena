{% extends 'base.html.twig' %}

{% block title %}Plants - {{ plant.name }}{% endblock %}

{% block header %}
    {% include 'partials/_app_navbar.html.twig' with { active_page: 'dashboard' } %}
{% endblock %}

{% block body %}
    <main class="max-w-5xl mx-auto px-6 py-12 pt-32 md:py-20">
        <div class="mb-8">
            <a href="{{ path('app_plants_index') }}"
               class="mb-8 inline-flex items-center font-medium text-primary transition-all duration-300 group">
                <span class="material-symbols-outlined mr-2 text-lg transition-transform group-hover:-translate-x-1">
                    arrow_back
                </span>
                <span class="text-sm uppercase tracking-wider">Zurück zur Liste</span>
            </a>
        </div>

        {# Card #}
        <div
            class="bg-surface-container-lowest rounded-xl shadow-[0px_20px_40px_rgba(46,52,51,0.06)] overflow-hidden relative border border-transparent">
            <div class="p-8 md:p-16 flex flex-col gap-12">
                <div class="flex flex-col md:flex-row justify-between items-start gap-6">
                    <div>
                        <h1 class="font-headline text-4xl md:text-5xl font-extrabold tracking-tight text-on-surface mb-2">
                            {{ plant.name }}
                        </h1>
                        <p class="font-label text-xs font-bold tracking-[0.2em] text-outline uppercase">
                            {% if plant.location %}
                                <a href="{{ path('app_locations_show', { id: plant.location.id }) }}"
                                   class="inline-flex items-center gap-1 hover:text-primary transition-colors">
                                    <span class="material-symbols-outlined text-xs">location_on</span>
                                    {{ plant.location.name }}
                                </a>
                            {% else %}
                                Kein Standort
                            {% endif %}
                        </p>
                    </div>

                    {# Buttons #}
                    <div class="flex items-center gap-3">

                        <a href="{{ path('app_plants_add', {'id': plant.id}) }}"
                           class="px-6 py-3 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-all flex items-center gap-2">
                            <span class="material-symbols-outlined text-lg">favorite</span>
                            Wunschliste
                        </a>

                        <a href="{{ path('app_plants_edit', {'id': plant.id}) }}"
                           class="px-6 py-3 bg-secondary-container text-on-secondary-container rounded-full font-medium text-sm hover:opacity-90 transition-all flex items-center gap-2">
                            <span class="material-symbols-outlined text-lg">edit</span>
                            Bearbeiten
                        </a>

                        {{ include('plants/_delete_form.html.twig') }}
                    </div>
                </div>

                {# Bild und Eigenschaften #}
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    <div class="lg:col-span-7 relative group">
                        <div
                            class="absolute -inset-4 bg-primary/5 rounded-xl -rotate-2 -z-10 transition-transform group-hover:rotate-1"></div>
                        <img
                            src="{{ plant.displayPhotoPath starts with 'http' ? plant.displayPhotoPath : asset(plant.displayPhotoPath) }}"
                            alt="{{ plant.name }}"
                            class="w-full min-h-[420px] rounded-lg object-cover shadow-sm"
                        />
                    </div>

                    <div class="lg:col-span-5 flex flex-col gap-10">
                        {# Stress(Fitness)Score #}
                        <div class="bg-surface-container-low rounded-lg p-8 flex items-center justify-between">
                            <div>
                                <p class="text-on-surface-variant font-medium text-sm mb-1">Health Score</p>
                                <p class="text-3xl font-bold text-on-surface">{{ plant.stressScore }}%</p>

                                {% if plant.stressScore < 40 %}
                                    <p class="text-[#E53935] text-xs font-semibold mt-2 flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs">error</span>
                                        Hoher Stress
                                    </p>
                                {% elseif plant.stressScore < 80 %}
                                    <p class="text-[#FFB300] text-xs font-semibold mt-2 flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs">warning</span>
                                        Leichter Stress
                                    </p>
                                {% else %}
                                    <p class="text-primary text-xs font-semibold mt-2 flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs">check_circle</span>
                                        Optimaler Zustand
                                    </p>
                                {% endif %}
                            </div>

                            {% set circumference = 213.6 %}
                            {% set dashOffset = circumference - (circumference * (plant.stressScore / 100)) %}

                            <div class="relative w-20 h-20">
                                <svg class="w-full h-full transform -rotate-90">
                                    <circle class="text-surface-container-highest" cx="40" cy="40" fill="transparent"
                                            r="34" stroke="currentColor" stroke-width="6"></circle>
                                    <circle class="text-primary" cx="40" cy="40" fill="transparent" r="34"
                                            stroke="currentColor" stroke-dasharray="{{ circumference }}"
                                            stroke-dashoffset="{{ dashOffset }}" stroke-width="6"></circle>
                                </svg>
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <span class="material-symbols-outlined text-primary">eco</span>
                                </div>
                            </div>
                        </div>

                        {# Letzte Pflegeaufgaben und Standort-Eignung #}
                        <div class="space-y-6">
                            {% if fitnessStatus %}
                                {% set status = fitnessStatus.status %}

                                <a href="{{ path('app_fitness_plant', { id: plant.id }) }}"
                                   class="flex items-center gap-4 rounded-lg p-2 -m-2 transition-colors hover:bg-surface-container-low">
                                    <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0
                                        {% if status.name == 'perfect' %}
                                            bg-primary-container text-on-primary-container
                                        {% elseif status.name == 'partly' %}
                                            bg-[#FFB300]/20 text-[#8A5A00]
                                        {% else %}
                                            bg-error-container text-error
                                        {% endif %}
                                        ">
                                        <span class="material-symbols-outlined text-xl">
                                            {% if status.name == 'perfect' %}
                                                check_circle
                                            {% elseif status.name == 'partly' %}
                                                warning
                                            {% else %}
                                                error
                                            {% endif %}
                                        </span>
                                    </div>

                                    <div>
                                        <p class="text-xs font-bold text-outline uppercase tracking-wider mb-1">
                                            Standort-Eignung
                                        </p>

                                        <p class="text-on-surface font-semibold text-lg">
                                            {{ status.value }}
                                        </p>

                                        <p class="text-on-surface-variant text-sm mt-1 italic">
                                            Bewertung basierend auf Licht, Temperatur und Luftfeuchtigkeit.
                                        </p>
                                    </div>
                                </a>
                            {% endif %}

                            <div class="flex items-start gap-4">
                                <div
                                    class="w-10 h-10 rounded-full bg-tertiary-container flex items-center justify-center text-on-tertiary-container shrink-0">
                                    <span class="material-symbols-outlined text-xl">schedule</span>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-outline uppercase tracking-wider mb-1">
                                        Bewässerung</p>
                                    <p class="text-on-surface font-semibold text-lg">
                                        Alle {{ plant.wateringIntervalDays }} Tage</p>
                                    <p class="text-on-surface-variant text-sm mt-1 italic">
                                        Zuletzt gegossen:
                                        {{ plant.lastWateredAt ? plant.lastWateredAt|date('d.m.Y') : '–' }}
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div
                                    class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container shrink-0">
                                    <span class="material-symbols-outlined text-xl">compost</span>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-outline uppercase tracking-wider mb-1">Düngung</p>
                                    <p class="text-on-surface font-semibold text-lg">
                                        Alle {{ plant.fertilizingIntervalDays }} Tage</p>
                                    <p class="text-on-surface-variant text-sm mt-1 italic">
                                        Zuletzt gedüngt:
                                        {{ plant.lastFertilizedAt ? plant.lastFertilizedAt|date('d.m.Y') : '–' }}
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-4">
                                <div
                                    class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container shrink-0">
                                    <span class="material-symbols-outlined text-xl">potted_plant</span>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-outline uppercase tracking-wider mb-1">Umtopfen</p>
                                    <p class="text-on-surface font-semibold text-lg">
                                        Alle {{ plant.repottingIntervalDays }} Tage</p>
                                    <p class="text-on-surface-variant text-sm mt-1 italic">
                                        Zuletzt umgetopft:
                                        {{ plant.lastRepottedAt ? plant.lastRepottedAt|date('d.m.Y') : '–' }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Eigenschaften #}
                {% set toxicityText =
                    plant.toxicForHumans and plant.toxicForAnimals ? 'giftig für Mensch & Tier' :
                    plant.toxicForHumans ? 'giftig für Menschen' :
                    plant.toxicForAnimals ? 'giftig für Tiere' :
                    'ungiftig' %}

                <div
                    class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8 pt-12 border-t border-surface-container-high">
                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-2 text-on-secondary-fixed-variant">
                            <span class="material-symbols-outlined text-xl">wb_sunny</span>
                            <span class="font-bold text-sm tracking-wide">LICHT</span>
                        </div>
                        <p class="text-on-surface font-medium">{{ plant.lightRequirement.value }}</p>
                        <p class="text-xs text-on-surface-variant">
                            Standortbedingung für diese Pflanze.
                        </p>
                    </div>

                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-2 text-on-secondary-fixed-variant">
                            <span class="material-symbols-outlined text-xl">thermostat</span>
                            <span class="font-bold text-sm tracking-wide">TEMPERATUR</span>
                        </div>
                        <p class="text-on-surface font-medium">{{ plant.temperatureRequirement.value }}</p>
                        <p class="text-xs text-on-surface-variant">
                            Empfohlener Temperaturbereich.
                        </p>
                    </div>

                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-2 text-on-secondary-fixed-variant">
                            <span class="material-symbols-outlined text-xl">water_drop</span>
                            <span class="font-bold text-sm tracking-wide">LUFTFEUCHTIGKEIT</span>
                        </div>
                        <p class="text-on-surface font-medium">{{ plant.humidityRequirement.value }}</p>
                        <p class="text-xs text-on-surface-variant">
                            Passende Umgebungsfeuchtigkeit für gesundes Wachstum.
                        </p>
                    </div>
                    <div class="flex flex-col gap-2">
                        <div
                            class="flex items-center gap-2 {{ plant.toxicForHumans or plant.toxicForAnimals ? 'text-error' : 'text-primary' }}">
                            <span class="material-symbols-outlined text-xl">
                                {{ plant.toxicForHumans or plant.toxicForAnimals ? 'warning' : 'check_circle' }}
                            </span>
                            <span class="font-bold text-sm tracking-wide">GIFTIGKEIT</span>
                        </div>

                        <p class="text-on-surface font-medium">{{ toxicityText }}</p>

                        <p class="text-xs text-on-surface-variant">
                            {% if plant.toxicForHumans or plant.toxicForAnimals %}
                                Vorsicht bei Kontakt oder Verzehr.
                            {% else %}
                                Keine bekannte Giftigkeit.
                            {% endif %}
                        </p>
                    </div>

                </div>

                <h3 class="font-headline font-bold text-lg text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined">description</span>
                    Beschreibung
                </h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">
                    {% if plant.description %}
                        {{ plant.description }}
                    {% else %}
                        Noch keine Notiz vorhanden.
                    {% endif %}
                </p>
            </div>
        </div>

        {# Pflegehistorie #}
        <div class="mt-12 bg-surface-container-lowest rounded-xl p-8 shadow-[0px_20px_40px_rgba(46,52,51,0.03)]">
            <h2 class="text-xl font-bold mb-6">Pflegehistorie</h2>

            <div class="space-y-4">
                {% for entry in plant.careHistory|slice(0, 5) %}
                    <div class="flex items-center justify-between rounded-xl bg-surface-container p-4">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center
                            {% if entry.careType.value == 'gießen' %}
                                bg-tertiary-container text-on-tertiary-container
                            {% elseif entry.careType.value == 'düngen' %}
                                bg-secondary-container text-on-secondary-container
                            {% else %}
                                bg-primary-container text-on-primary-container
                            {% endif %}
                        ">
                            <span class="material-symbols-outlined">
                                {% if entry.careType.value == 'gießen' %}
                                    water_drop
                                {% elseif entry.careType.value == 'düngen' %}
                                    compost
                                {% else %}
                                    potted_plant
                                {% endif %}
                            </span>
                            </div>

                            <div>
                                <p class="font-semibold text-on-surface capitalize">
                                    {{ entry.careType.value }}
                                </p>
                                <p class="text-sm text-on-surface-variant">
                                    {{ entry.performedAt|date('d.m.Y H:i') }}
                                </p>
                            </div>
                        </div>

                        <span class="material-symbols-outlined text-on-surface-variant text-lg">
                        check_circle
                    </span>
                    </div>
                {% else %}
                    <p class="text-sm text-on-surface-variant">
                        Noch keine Pflegehistorie vorhanden.
                    </p>
                {% endfor %}
            </div>
        </div>

        {# Notizen #}
        <div class="mt-12 grid grid-cols-1 gap-8">
            <div class="p-8 bg-surface-container rounded-lg">
                <div class="flex justify-between items-center gap-4 mb-4">
                    <h3 class="font-headline font-bold text-lg text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined">description</span>
                        Notizen
                    </h3>
                </div>

                <div class="text-on-surface-variant text-sm leading-relaxed">
                    {% for note in plant.plantNotes %}
                        <div class="py-4 border-t border-surface-container-high">
                            <p>zuletzt bearbeteit am: {% if note.createdAt == note.updatedAt %}{{ note.createdAt|date('d.m.Y H:s', 'CEST') }}{% else %}{{ note.updatedAt|date('d.m.Y H:s', 'CEST') }}{% endif %}</p>
                            <p>{{ note.content }}</p>
                            <a href="{{ path('app_plant_notes_edit', {'id': plant.id, 'note': note.id}) }}">bearbeiten</a>
                            {{ include('plant_notes/_delete_form.html.twig', {'id': plant.id, 'plant_note': note})  }}
                        </div>
                    {% else %}
                        Noch keine Notizen vorhanden.
                    {% endfor %}
                </div>
            </div>
        </div>
    </main>
{% endblock %}
