{% extends 'base.html.twig' %}

{% block title %}Pflanze bearbeiten{% endblock %}

{% block header %}
    {% include 'partials/_app_navbar.html.twig' with { active_page: 'dashboard' } %}
{% endblock %}

{% block body %}
    <main class="mx-auto max-w-5xl px-6 py-16 pt-32 lg:py-24">
        <header class="mb-12">
            <a href="{{ path('app_plants_show', {'id': plant.id}) }}"
               class="mb-8 inline-flex items-center font-medium text-primary transition-all duration-300 group">
                <span class="material-symbols-outlined mr-2 text-lg transition-transform group-hover:-translate-x-1">
                    arrow_back
                </span>
                <span class="text-sm uppercase tracking-wider">Zurück zur Pflanze</span>
            </a>

            <div>
                <h1 class="mb-4 text-4xl font-extrabold tracking-tight text-on-surface">
                    Pflanze <span class="italic text-primary">bearbeiten</span>
                </h1>
                <p class="max-w-2xl text-lg leading-relaxed text-on-surface-variant">
                    Aktualisiere die Informationen deiner Pflanze.
                </p>
            </div>
        </header>

        {{ include('plants/_form.html.twig', {
            'button_label': 'Bearbeiten'
        }) }}

        <div class="mt-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                {{ include('plants/_delete_form.html.twig', { plant: plant }) }}
            </div>

            <a href="{{ path('app_plants_index') }}"
            class="text-sm font-semibold text-on-surface-variant underline-offset-4 hover:underline">
                Zurück zur Liste
            </a>
        </div>

    </main>
{% endblock %}