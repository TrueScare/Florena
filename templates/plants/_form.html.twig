{{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

<div class="overflow-hidden rounded-xl bg-surface-container-lowest shadow-[0_20px_40px_rgba(46,52,51,0.06)]">

    {# Basisinformationen #}
    <section class="border-b border-surface-container p-8 md:p-12 space-y-10">
        <div class="mb-8 flex items-center gap-3">
            <span class="rounded-lg bg-primary-container p-2 text-on-primary-container">
                <span class="material-symbols-outlined block">potted_plant</span>
            </span>
            <h2 class="text-2xl font-bold tracking-tight">Basisinformationen</h2>
        </div>

        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
            <div class="space-y-6 lg:col-span-7">
                <div class="space-y-2">
                    {{ form_label(form.name, null, {
                        label_attr: {
                            class: 'flex items-center font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.name, {
                        attr: {
                            class: 'w-full rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface placeholder:text-outline-variant transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                            placeholder: 'z.B. Luna die Monstera'
                        }
                    }) }}
                    {{ form_errors(form.name) }}
                </div>

                <div class="space-y-2">
                    {{ form_label(form.botanical_name, null, {
                        label_attr: {
                            class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.botanical_name, {
                        attr: {
                            class: 'w-full rounded-lg border-transparent bg-surface-container-low px-5 py-4 italic text-on-surface placeholder:text-outline-variant transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                            placeholder: 'z.B. Monstera Deliciosa'
                        }
                    }) }}
                    {{ form_errors(form.botanical_name) }}
                </div>

                <div class="space-y-2">
                    {{ form_label(form.description, null, {
                        label_attr: {
                            class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.description, {
                        attr: {
                            class: 'w-full resize-none rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface placeholder:text-outline-variant transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                            placeholder: 'Erzähle etwas über die Pflanze...',
                            rows: 4
                        }
                    }) }}
                    {{ form_errors(form.description) }}
                </div>
            </div>

            <div class="lg:col-span-5">
                <div class="flex flex-col space-y-2">
                    {{ form_label(form.image, null, {
                        label_attr: {
                            class: 'mb-2 font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}

                    <div class="relative w-full">
                        {{ form_widget(form.image, {
                            attr: {
                                class: 'sr-only peer'
                            }
                        }) }}

                        <label for="{{ form.image.vars.id }}"
                            class="group flex min-h-[280px] w-full flex-col items-center justify-center rounded-xl border-2 border-dashed border-outline-variant/30 bg-surface-container-low p-8 text-center transition-all hover:bg-surface-variant">
                            <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-surface-container-highest transition-transform group-hover:scale-110">
                                <span class="material-symbols-outlined text-3xl text-primary">add_a_photo</span>
                            </div>

                            <p class="mb-1 font-semibold text-on-surface">Bild hochladen</p>
                            <p class="text-xs text-on-surface-variant">JPG, PNG oder HEIC (max. 10MB)</p>
                        </label>
                    </div>

                    {{ form_errors(form.image) }}
                </div>
            </div>
        </div>
    </section>


    {# Pflegegrundlagen #}
    <section class="border-b border-surface-container bg-surface-container-low/30 p-8 md:p-12 space-y-10">
        <div class="mb-8 flex items-center gap-3">
            <span class="rounded-lg bg-tertiary-container p-2 text-on-tertiary-container">
                <span class="material-symbols-outlined block">water_drop</span>
            </span>
            <h2 class="text-2xl font-bold tracking-tight text-on-surface">Pflegegrundlagen</h2>
        </div>

        <div class="grid grid-cols-1 gap-x-12 gap-y-8 md:grid-cols-2">
            <div class="space-y-4">
                <div class="mb-2 flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm text-primary">schedule</span>
                    <span class="text-xs font-bold uppercase tracking-widest text-primary">Bewässerung</span>
                </div>

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="space-y-2">
                        {{ form_label(form.watering_interval_days, null, {
                            label_attr: {
                                class: 'font-label text-[10px] font-bold uppercase tracking-wider text-on-surface-variant'
                            }
                        }) }}
                        {{ form_widget(form.watering_interval_days, {
                            attr: {
                                class: 'w-full rounded-lg border-transparent bg-surface-container-lowest px-4 py-3 text-on-surface shadow-sm transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                                placeholder: '7',
                                min: 1
                            }
                        }) }}
                        {{ form_errors(form.watering_interval_days) }}
                    </div>

                    <div class="space-y-2">
                        {{ form_label(form.last_watered_at, null, {
                            label_attr: {
                                class: 'font-label text-[10px] font-bold uppercase tracking-wider text-on-surface-variant'
                            }
                        }) }}
                        {{ form_widget(form.last_watered_at, {
                            attr: {
                                class: 'w-full rounded-lg border-transparent bg-surface-container-lowest px-4 py-3 text-on-surface shadow-sm transition-all focus:border-primary focus:ring-4 focus:ring-primary/10'
                            }
                        }) }}
                        {{ form_errors(form.last_watered_at) }}
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <div class="mb-2 flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm text-primary">eco</span>
                    <span class="text-xs font-bold uppercase tracking-widest text-primary">Düngung</span>
                </div>

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="space-y-2">
                        {{ form_label(form.fertilizing_interval_days, null, {
                            label_attr: {
                                class: 'font-label text-[10px] font-bold uppercase tracking-wider text-on-surface-variant'
                            }
                        }) }}
                        {{ form_widget(form.fertilizing_interval_days, {
                            attr: {
                                class: 'w-full rounded-lg border-transparent bg-surface-container-lowest px-4 py-3 text-on-surface shadow-sm transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                                placeholder: '14',
                                min: 0
                            }
                        }) }}
                        {{ form_errors(form.fertilizing_interval_days) }}
                    </div>

                    <div class="space-y-2">
                        {{ form_label(form.last_fertilized_at, null, {
                            label_attr: {
                                class: 'font-label text-[10px] font-bold uppercase tracking-wider text-on-surface-variant'
                            }
                        }) }}
                        {{ form_widget(form.last_fertilized_at, {
                            attr: {
                                class: 'w-full rounded-lg border-transparent bg-surface-container-lowest px-4 py-3 text-on-surface shadow-sm transition-all focus:border-primary focus:ring-4 focus:ring-primary/10'
                            }
                        }) }}
                        {{ form_errors(form.last_fertilized_at) }}
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <div class="mb-2 flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm text-primary">grid_view</span>
                    <span class="text-xs font-bold uppercase tracking-widest text-primary">Umtopfen</span>
                </div>

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="space-y-2">
                        {{ form_label(form.repotting_interval_days, null, {
                            label_attr: {
                                class: 'font-label text-[10px] font-bold uppercase tracking-wider text-on-surface-variant'
                            }
                        }) }}
                        {{ form_widget(form.repotting_interval_days, {
                            attr: {
                                class: 'w-full rounded-lg border-transparent bg-surface-container-lowest px-4 py-3 text-on-surface shadow-sm transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                                placeholder: '365',
                                min: 0
                            }
                        }) }}
                        {{ form_errors(form.repotting_interval_days) }}
                    </div>

                    <div class="space-y-2">
                        {{ form_label(form.last_repotted_at, null, {
                            label_attr: {
                                class: 'font-label text-[10px] font-bold uppercase tracking-wider text-on-surface-variant'
                            }
                        }) }}
                        {{ form_widget(form.last_repotted_at, {
                            attr: {
                                class: 'w-full rounded-lg border-transparent bg-surface-container-lowest px-4 py-3 text-on-surface shadow-sm transition-all focus:border-primary focus:ring-4 focus:ring-primary/10'
                            }
                        }) }}
                        {{ form_errors(form.last_repotted_at) }}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div
        data-controller="plant-location-suggestions"
        data-plant-location-suggestions-url-value="{{ path('app_api_fitness_location') }}"
    >
        {# Umgebung #}
        <section class="border-b border-surface-container p-8 md:p-12 space-y-10">
            <div class="mb-8 flex items-center gap-3">
                <span class="rounded-lg bg-surface-container-highest p-2 text-on-surface">
                    <span class="material-symbols-outlined block">wb_sunny</span>
                </span>
                <h2 class="text-2xl font-bold tracking-tight">Umgebung</h2>
            </div>

            <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
                <div class="space-y-2">
                    {{ form_label(form.light_requirement, null, {
                        label_attr: {
                            class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.light_requirement, {
                        attr: {
                            'data-plant-location-suggestions-target': 'light',
                            'data-action': 'change->plant-location-suggestions#refresh',
                            class: 'w-full appearance-none rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface transition-all focus:border-primary focus:ring-4 focus:ring-primary/10'
                        }
                    }) }}
                    {{ form_errors(form.light_requirement) }}
                </div>

                <div class="space-y-2">
                    {{ form_label(form.temperature_requirement, null, {
                        label_attr: {
                            class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.temperature_requirement, {
                        attr: {
                            'data-plant-location-suggestions-target': 'temperature',
                            'data-action': 'change->plant-location-suggestions#refresh',
                            class: 'w-full appearance-none rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface transition-all focus:border-primary focus:ring-4 focus:ring-primary/10'
                        }
                    }) }}
                    {{ form_errors(form.temperature_requirement) }}
                </div>

                <div class="space-y-2">
                    {{ form_label(form.humidity_requirement, null, {
                        label_attr: {
                            class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.humidity_requirement, {
                        attr: {
                            'data-plant-location-suggestions-target': 'humidity',
                            'data-action': 'change->plant-location-suggestions#refresh',
                            class: 'w-full appearance-none rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface transition-all focus:border-primary focus:ring-4 focus:ring-primary/10'
