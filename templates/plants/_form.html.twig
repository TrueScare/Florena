                    }) }}
                    {{ form_errors(form.humidity_requirement) }}
                </div>

                <div class="space-y-2">
                    {{ form_label(form.soil_type, null, {
                        label_attr: {
                            class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.soil_type, {
                        attr: {
                            class: 'w-full rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface placeholder:text-outline-variant transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                            placeholder: 'z.B. Kokoserde-Mix'
                        }
                    }) }}
                    {{ form_errors(form.soil_type) }}
                </div>

                <div class="space-y-2">
                    {{ form_label(form.pot_size, null, {
                        label_attr: {
                            class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.pot_size, {
                        attr: {
                            class: 'w-full rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface placeholder:text-outline-variant transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                            placeholder: 'z.B. 15 cm Ø'
                        }
                    }) }}
                    {{ form_errors(form.pot_size) }}
                </div>
            </div>
        </section>

        {# Standort #}
        <section class="border-b border-surface-container bg-surface-container-low/30 p-8 md:p-12 space-y-6">
            <div class="mb-8 flex items-center gap-3">
                <span class="rounded-lg bg-primary-container p-2 text-on-primary-container">
                    <span class="material-symbols-outlined block">location_on</span>
                </span>
                <h2 class="text-2xl font-bold tracking-tight">Standort</h2>
            </div>

            <div class="max-w-xl space-y-2">
                {{ form_label(form.location, null, {
                    label_attr: {
                        class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                    }
                }) }}
                {{ form_widget(form.location, {
                    attr: {
                        'data-plant-location-suggestions-target': 'location',
                        class: 'w-full rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface transition-all focus:border-primary focus:ring-4 focus:ring-primary/10'
                    }
                }) }}
                {{ form_errors(form.location) }}
                <p
                    data-plant-location-suggestions-target="status"
                    class="text-xs text-on-surface-variant"
                >
                    Standortvorschläge basieren auf Lichtbedarf, Temperaturbedarf und Luftfeuchtigkeit.
                </p>
            </div>
        </section>
    </div>

    {# Weitere Eigenschaften #}
    <section class="p-8 md:p-12 space-y-10">
        <div class="mb-8 flex items-center gap-3">
            <span class="rounded-lg bg-secondary-container p-2 text-on-secondary-container">
                <span class="material-symbols-outlined block">assignment</span>
            </span>
            <h2 class="text-2xl font-bold tracking-tight">Weitere Eigenschaften</h2>
        </div>

        <div class="grid grid-cols-1 gap-12 max-w-2xl">
            <div class="space-y-8">
                <div class="flex items-center justify-between rounded-xl border border-surface-container bg-surface-container-low p-4">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-error">warning</span>
                        <div>
                            <p class="text-sm font-bold">Giftig für Menschen</p>
                            <p class="text-xs text-on-surface-variant">Bei Verzehr oder Kontakt gefährlich</p>
                        </div>
                    </div>
                    <div class="shrink-0">
                        {{ form_widget(form.toxic_for_humans, {
                            attr: {
                                class: 'h-5 w-5 rounded border-outline-variant text-primary focus:ring-4 focus:ring-primary/10'
                            }
                        }) }}
                    </div>
                </div>
                {{ form_errors(form.toxic_for_humans) }}

                <div class="flex items-center justify-between rounded-xl border border-surface-container bg-surface-container-low p-4">
                    <div class="flex items-center gap-4">
                        <span class="material-symbols-outlined text-error">pets</span>
                        <div>
                            <p class="text-sm font-bold">Giftig für Tiere</p>
                            <p class="text-xs text-on-surface-variant">Gefahr für Hunde, Katzen &amp; Co.</p>
                        </div>
                    </div>
                    <div class="shrink-0">
                        {{ form_widget(form.toxic_for_animals, {
                            attr: {
                                class: 'h-5 w-5 rounded border-outline-variant text-primary focus:ring-4 focus:ring-primary/10'
                            }
                        }) }}
                    </div>
                </div>
                {{ form_errors(form.toxic_for_animals) }}

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="space-y-2">
                        {{ form_label(form.purchase_date, null, {
                            label_attr: {
                                class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                            }
                        }) }}
                        {{ form_widget(form.purchase_date, {
                            attr: {
                                class: 'w-full rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface shadow-sm transition-all focus:border-primary focus:ring-4 focus:ring-primary/10'
                            }
                        }) }}
                        {{ form_errors(form.purchase_date) }}
                    </div>
                </div>
            </div>
        </div>
    </section>

</div>

<div class="mt-10 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

    <div class="flex flex-col items-center justify-end gap-4 md:flex-row">
        <a href="{{ path('app_plants_index') }}"
           class="w-full px-10 py-4 text-center font-bold text-on-surface-variant transition-colors hover:text-on-surface md:w-auto">
            Abbrechen
        </a>

        <button type="submit"
                class="flex w-full items-center justify-center gap-2 rounded-full bg-primary px-12 py-4 font-bold text-on-primary shadow-[0_10px_20px_rgba(61,107,0,0.2)] transition-all active:scale-95 md:w-auto">
            <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">save</span>
            {{ button_label|default('Speichern') }}
        </button>
    </div>
</div>

{{ form_widget(form._token) }}
{{ form_widget(form.user) }}
{{ form_widget(form.wishlist_plant) }}
