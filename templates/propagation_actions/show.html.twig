{% extends 'base.html.twig' %}

{% block title %}PropagationActions{% endblock %}

{% block body %}
    <h1>PropagationActions</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Method</th>
                <td>{{ propagation_action.method.value }}</td>
            </tr>
            <tr>
                <th>Planned_date</th>
                <td>{{ propagation_action.plannedDate ? propagation_action.plannedDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ propagation_action.status.value }}</td>
            </tr>
            <tr>
                <th>Notes</th>
                <td>{{ propagation_action.notes }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_propagation_actions_index') }}">zurück zur Liste</a>

    <a href="{{ path('app_propagation_actions_edit', {'id': propagation_action.id}) }}">bearbeiten</a>

    {{ include('propagation_actions/_delete_form.html.twig') }}
{% endblock %}
