{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block header %}
    {% include 'partials/_app_navbar.html.twig' with { active_page: 'dashboard' } %}
{% endblock %}

{% block body %}
    {% if isMinimalMode %}
        {% include 'partials/_minimal_care_tasks.html.twig' %}
    {% else %}
    
    <main class="mx-auto max-w-[1440px] px-8 pb-24 pt-32">
        <header class="mb-12">
            <h1 class="mb-2 text-4xl font-extrabold tracking-tight text-on-surface">
                <span class="text-4xl md:text-5xl font-extrabold text-primary tracking-tight mb-2">Guten Tag, {{ dashboardGreetingName }}</span>
            </h1>
            <p class="font-body text-on-surface-variant">
                Deine botanischen Freunde benötigen heute ein wenig Aufmerksamkeit.
            </p>
        </header>

        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">

            {# Aufgaben #}
            <section class="space-y-6 lg:col-span-4">
                <div class="flex items-center justify-between px-2">
                    <h2 class="text-xl font-bold tracking-tight">Anstehende Aufgaben</h2>
                    <a href="{{ path('app_care_task_index') }}">
                        <span class="cursor-pointer text-sm font-semibold text-primary underline-offset-4 hover:underline">
                            Alle ansehen
                        </span>
                    </a>
                </div>

                {# Aufgaben-Card #}
                <div class="space-y-4">
                    {% for task in upcomingTasks %}
                        {% include 'partials/_care_task_card.html.twig' with {
                            task: task,
                            showDoneButton: not task.hideDoneButton|default(false)
                        } %}
                    {% else %}
                        <div class="rounded-xl bg-surface-container-lowest p-5 text-sm text-on-surface-variant shadow-[0px_10px_30px_rgba(46,52,51,0.04)]">
                            Keine anstehenden Aufgaben vorhanden.
                        </div>
                    {% endfor %}
                </div>
            </section>

            {#  Pflanzen und Standorte #}
            <section class="space-y-6 lg:col-span-8">
                <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">

                    {# Pflanzen #}
                    <div class="space-y-6 xl:col-span-8">
                        <div class="flex items-center justify-between">
                            <h2 class="text-xl font-bold tracking-tight">Meine Pflanzen</h2>
                            <div class="flex items-center gap-3 h-10">
                                <a href="{{ path('app_plants_index') }}"
                                class="flex items-center h-10 text-sm font-semibold text-primary underline-offset-4 hover:underline">
                                    Alle ansehen
                                </a>
                                <a href="{{ path('app_plants_new') }}"
                                class="group relative flex h-10 w-10 items-center justify-center rounded-full bg-primary text-on-primary shadow-lg shadow-primary/20 transition-transform hover:scale-105">
                                    <span class="material-symbols-outlined text-[22px]">add</span>
                                </a>
                            </div>
                        </div>

                        {# Pflanzen-Card #}
                        <div class="grid grid-cols-1 gap-6">
                            {% for plant in plants %}
                                {% include 'partials/_plant_card.html.twig' with { plant: plant } %}
                            {% else %}
                                <div class="rounded-xl bg-surface-container-lowest p-5 text-sm text-on-surface-variant">
                                    Noch keine Pflanzen vorhanden.
                                </div>
                            {% endfor %}
                        </div>
                    </div>


                    {# Standorte #}
                    <div class="space-y-6 xl:col-span-4">

                        <div class="flex items-center justify-between">
                            <h2 class="text-xl font-bold tracking-tight">Standorte</h2>

                            <div class="flex items-center gap-2">
                                <a href="{{ path('app_locations_index') }}"
                                class="text-sm font-semibold text-primary hover:underline">
                                    Alle ansehen
                                </a>

                                <a href="{{ path('app_locations_new') }}"
                                class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-on-primary shadow-lg">
                                    <span class="material-symbols-outlined">add</span>
                                </a>
                            </div>
                        </div>

                        <div class="space-y-4">
                            {% for location in locations %}
                                <a href="{{ path('app_locations_show', { id: location.id }) }}"
                                class="block cursor-pointer transition-transform hover:scale-[1.01]">

                                    <article class="
                                        flex items-center justify-between
                                        rounded-xl
                                        border border-transparent
                                        bg-surface-container-lowest
                                        p-5
                                        shadow-[0px_20px_40px_rgba(46,52,51,0.03)]
                                        transition-all
                                        hover:border-primary-fixed
                                        ">
                                        
                                        <div class="flex min-w-0 flex-1 items-center gap-3">
                                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-container text-on-primary-container">
                                                <span class="material-symbols-outlined">location_on</span>
                                            </div>

                                            <h3 class="truncate font-bold leading-tight">
                                                {{ location.name }}
                                            </h3>
                                        </div>

                                        <div class="ml-3 flex w-6 shrink-0 items-center justify-end">
                                            <span class="material-symbols-outlined text-[20px] leading-none text-on-surface-variant">
                                                chevron_right
                                            </span>
                                        </div>
                                    </article>
                                </a>
                            {% else %}
                                <div class="rounded-xl bg-surface-container-lowest p-5 text-sm text-on-surface-variant">
                                    Noch keine Standorte vorhanden.
                                </div>
                            {% endfor %}
                        </div>

                    </div>

                </div>
            </section>
        </div>
    </main>
    {% endif %}
{% endblock %}
