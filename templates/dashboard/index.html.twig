{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block header %}
    {% include 'partials/_app_navbar.html.twig' with { active_page: 'dashboard' } %}
{% endblock %}

{% block body %}
    {% set taskIconMap = {
        'Gießen': {
            icon: 'water_drop',
            iconBackgroundClass: 'bg-secondary-container',
            iconTextClass: 'text-primary'
        },
        'Umtopfen': {
            icon: 'potted_plant',
            iconBackgroundClass: 'bg-tertiary-container',
            iconTextClass: 'text-tertiary'
        },
        'Düngen': {
            icon: 'eco',
            iconBackgroundClass: 'bg-primary-fixed',
            iconTextClass: 'text-on-primary-fixed'
        }
    } %}
    <main class="mx-auto max-w-[1440px] px-8 pb-24 pt-32">
        <header class="mb-12">
            <h1 class="mb-2 text-4xl font-extrabold tracking-tight text-on-surface">
                Guten Morgen, {{ dashboardGreetingName }}
            </h1>
            <p class="font-body text-on-surface-variant">
                Deine botanischen Freunde benötigen heute ein wenig Aufmerksamkeit.
            </p>
        </header>

        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">

            {# Aufgaben #}
            <section class="space-y-6 lg:col-span-4">
                <div class="flex items-center justify-between px-2">
                    <h2 class="text-xl font-bold tracking-tight">Anstehende Aufgaben</h2>
                    <span class="cursor-pointer text-sm font-semibold text-primary underline-offset-4 hover:underline">
                        Alle ansehen
                    </span>
                </div>

                <div class="space-y-4">
                    {% for task in upcomingTasks %}
                        {% set taskPresentation = taskIconMap[task.type]|default({
                            icon: 'local_florist',
                            iconBackgroundClass: 'bg-surface-container-high',
                            iconTextClass: 'text-on-surface-variant'
                        }) %}
                        <div class="group flex items-center justify-between rounded-xl bg-surface-container-lowest p-5 shadow-[0px_10px_30px_rgba(46,52,51,0.04)] transition-all hover:scale-[1.01]">
                            <div class="flex items-center gap-4">
                                <div class="flex h-12 w-12 items-center justify-center rounded-full {{ taskPresentation.iconBackgroundClass }} {{ taskPresentation.iconTextClass }}">
                                    <span class="material-symbols-outlined">{{ taskPresentation.icon }}</span>
                                </div>
                                <div>
                                    <h3 class="font-bold leading-tight text-on-surface">{{ task.type }}</h3>
                                    <p class="text-sm text-on-surface-variant">{{ task.plant }}</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <button type="button"
                                        class="rounded-full bg-primary px-5 py-2 text-sm font-semibold text-on-primary transition-all hover:bg-primary-dim active:scale-95">
                                    Erledigen
                                </button>
                                {% if task.dueDate %}
                                    <p class="mt-2 text-xs font-medium text-on-surface-variant">
                                        Fällig {{ task.dueDate|date('d.m.Y') }}
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <div class="rounded-xl bg-surface-container-lowest p-5 text-sm text-on-surface-variant shadow-[0px_10px_30px_rgba(46,52,51,0.04)]">
                            Keine anstehenden Aufgaben vorhanden.
                        </div>
                    {% endfor %}
                </div>
            </section>

            {#  Pflanzen und Standorte #}
            <section class="space-y-6 lg:col-span-8">
                <div class="grid grid-cols-1 gap-8 xl:grid-cols-12">

                    {# Pflanzen #}
                    <div class="space-y-6 xl:col-span-8">
                        <div class="flex items-center justify-between">
                            <h2 class="text-xl font-bold tracking-tight">Meine Pflanzen</h2>
                            <div class="flex items-center gap-3 h-10">
                                <a href="{{ path('app_plants_index') }}"
                                class="flex items-center h-10 text-sm font-semibold text-primary underline-offset-4 hover:underline">
                                    Alle ansehen
                                </a>
                                <a href="{{ path('app_plants_new') }}"
                                class="group relative flex h-10 w-10 items-center justify-center rounded-full bg-primary text-on-primary shadow-lg shadow-primary/20 transition-transform hover:scale-105">
                                    <span class="material-symbols-outlined text-[22px]">add</span>
                                </a>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-6">
                            {% for plant in plants %}
                                {% set stressBadgeClass = plant.stressLevel >= 80
                                    ? 'bg-[#E53935]/10 border-[#E53935]/20'
                                    : (plant.stressLevel >= 40 ? 'bg-[#FFB300]/10 border-[#FFB300]/20' : 'bg-[#7CB342]/10 border-[#7CB342]/20') %}
                                {% set stressTextClass = plant.stressLevel >= 80
                                    ? 'text-[#E53935]'
                                    : (plant.stressLevel >= 40 ? 'text-[#FFB300]' : 'text-[#7CB342]') %}

                                <a href="{{ path('app_plants_show', { id: plant.id }) }}"
                                class="block cursor-pointer transition-transform hover:scale-[1.01]">
                                    <article class="flex items-center gap-5 rounded-xl border border-transparent bg-surface-container-lowest p-4 shadow-[0px_20px_40px_rgba(46,52,51,0.03)] transition-all hover:border-primary-fixed">
                                        <div class="h-24 w-24 overflow-hidden rounded-lg">
                                            <img src="{{ plant.imageUrl }}"
                                                alt="{{ plant.imageAlt }}"
                                                class="h-full w-full object-cover">
                                        </div>

                                        <div class="flex-grow">
                                            <h3 class="text-lg font-bold">{{ plant.name }}</h3>
                                            <p class="text-xs uppercase tracking-widest text-on-surface-variant">
                                                {{ plant.location }}
                                            </p>
                                        </div>

                                        <div class="text-center">
                                            <div class="rounded-full border px-3 py-1 {{ stressBadgeClass }}">
                                                <span class="text-xs font-bold {{ stressTextClass }}">
                                                    {{ plant.stressLevel }}%
                                                </span>
                                            </div>
                                            <span class="text-[10px] font-bold text-on-surface-variant">
                                                STRESS
                                            </span>
                                        </div>
                                    </article>
                                </a>
                            {% else %}
                                <div class="rounded-xl bg-surface-container-lowest p-5 text-sm text-on-surface-variant">
                                    Noch keine Pflanzen vorhanden.
                                </div>
                            {% endfor %}
                        </div>
                    </div>


                    {# Standorte #}
                    <div class="space-y-6 xl:col-span-4">

                        <div class="flex items-center justify-between">
                            <h2 class="text-xl font-bold tracking-tight">Standorte</h2>

                            <div class="flex items-center gap-2">
                                <a href="{{ path('app_locations_index') }}"
                                class="text-sm font-semibold text-primary hover:underline">
                                    Alle ansehen
                                </a>

                                <a href="{{ path('app_locations_new') }}"
                                class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-on-primary shadow-lg">
                                    <span class="material-symbols-outlined">add</span>
                                </a>
                            </div>
                        </div>

                        <div class="space-y-4">
                            {% for location in locations %}
                                <article class="rounded-xl bg-surface-container-lowest p-5 shadow-[0px_20px_40px_rgba(46,52,51,0.03)]">

                                    <div class="mb-3 flex items-center gap-3">
                                        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-container text-on-primary-container">
                                            <span class="material-symbols-outlined">location_on</span>
                                        </div>
                                        

                                        <div>
                                            <h3 class="font-bold">{{ location.name }}</h3>
                                            <p class="text-xs text-on-surface-variant">Standort</p>
                                        </div>
                                    </div>

                                    {% if location.description %}
                                        <p class="mb-3 text-sm text-on-surface-variant line-clamp-2">
                                            {{ location.description }}
                                        </p>
                                    {% endif %}

                                </article>
                            {% else %}
                                <div class="rounded-xl bg-surface-container-lowest p-5 text-sm text-on-surface-variant">
                                    Noch keine Standorte vorhanden.
                                </div>
                            {% endfor %}
                        </div>

                    </div>

                </div>
            </section>
        </div>
    </main>
{% endblock %}
