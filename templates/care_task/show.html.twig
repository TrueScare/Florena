{% extends 'base.html.twig' %}

{% block title %}Aufgabe - {{ care_task.plant.name }} - {{ care_task.taskType.value }}{% endblock %}

{% block body %}
    <h1>Aufgabe - {{ care_task.plant.name }} - {{ care_task.taskType.value }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Task_type</th>
                <td>{{ care_task.taskType.value }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ care_task.createdAt ? care_task.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_care_task_index') }}">Zurück zur Liste</a>
{% endblock %}
