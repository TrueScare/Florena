{% extends 'base.html.twig' %}

{% block title %}Aufgaben{% endblock %}

{% block header %}
    {% include 'partials/_app_navbar.html.twig' with { active_page: 'calendar' } %}
{% endblock %}

{% block body %}
    {% set taskTypeStyles = {
        'gießen': {
            icon: 'water_drop',
            accent: 'text-primary',
            surface: 'bg-secondary-container'
        },
        'düngen': {
            icon: 'eco',
            accent: 'text-on-primary-fixed',
            surface: 'bg-primary-fixed'
        },
        'umtopfen': {
            icon: 'potted_plant',
            accent: 'text-tertiary',
            surface: 'bg-tertiary-container'
        }
    } %}

    {% set todayKey = 'now'|date('Y-m-d') %}
    {% set nowTs = 'now'|date('U') %}
    {% set overdueCount = 0 %}
    {% set dueTodayCount = 0 %}
    {% set tasksByDay = {} %}

    {% for item in care_task_items %}
        {% set care_task = item.task %}
        {% set dayKey = care_task.dueDate|date('Y-m-d') %}
        {% set currentTasks = tasksByDay[dayKey]|default([]) %}
        {% set tasksByDay = tasksByDay|merge({ (dayKey): currentTasks|merge([item]) }) %}

        {% if care_task.dueDate|date('U') < nowTs and dayKey != todayKey %}
            {% set overdueCount = overdueCount + 1 %}
        {% endif %}

        {% if dayKey == todayKey %}
            {% set dueTodayCount = dueTodayCount + 1 %}
        {% endif %}
    {% endfor %}

    {% set intervalLabel = interval == 'Tag' ? 'Tagesansicht' : (interval == 'Monat' ? 'Monatsansicht' : 'Wochenansicht') %}
    {% set weekStart = date('monday this week') %}
    {% set monthStart = date('first day of this month') %}
    {% set monthEnd = date('last day of this month') %}
    {% set leadingEmptyDays = monthStart|date('N') - 1 %}
    {% set daysInMonth = monthStart|date('t') %}

    <main class="mx-auto max-w-[1440px] px-4 pb-24 pt-28 sm:px-8">
        <section class="mb-12 flex flex-col gap-6 xl:flex-row xl:items-end xl:justify-between">
            <div>
                <h1 class="mb-2 text-4xl font-extrabold tracking-tight text-primary md:text-5xl">
                    Pflegeaufgaben
                </h1>

                    Alle anstehenden Pflegeaufgaben auf einen Blick. Die aktuelle {{ intervalLabel|lower }}
                    zeigt überfällige und bevorstehende Aufgaben deiner Pflanzen.
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 xl:min-w-[30rem]">
                    <article class="rounded-3xl bg-surface-container-lowest/90 px-5 py-4 shadow-[0px_12px_30px_rgba(46,52,51,0.06)]">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-on-surface-variant">Insgesamt</p>
                        <p class="mt-2 text-3xl font-extrabold text-on-surface">{{ care_task_items|length }}</p>
                    </article>
                    <article class="rounded-3xl bg-surface-container-lowest/90 px-5 py-4 shadow-[0px_12px_30px_rgba(46,52,51,0.06)]">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-on-surface-variant">Heute</p>
                        <p class="mt-2 text-3xl font-extrabold text-primary">{{ dueTodayCount }}</p>
                    </article>
                    <article class="rounded-3xl bg-surface-container-lowest/90 px-5 py-4 shadow-[0px_12px_30px_rgba(46,52,51,0.06)]">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-on-surface-variant">Überfällig</p>
                        <p class="mt-2 text-3xl font-extrabold text-error">{{ overdueCount }}</p>
                    </article>
            </div>
        </section>

        {% if received_task_items is not empty %}
            <section class="mt-8 rounded-[1.75rem] bg-surface-container-lowest p-5 shadow-[0px_18px_45px_rgba(46,52,51,0.04)]">
                <div class="mb-4">
                    <div>
                        <h4 class="text-lg font-bold text-on-surface">An dich übergebene Aufgaben</h4>
                    </div>
                </div>

                <div class="space-y-3">
                    {% for item in received_task_items %}
                        {% set care_task = item.task %}
                        {% set typeLabel =
                            care_task.taskType.value == 'gießen' ? 'Gießen' :
                            care_task.taskType.value == 'düngen' ? 'Düngen' :
                            care_task.taskType.value == 'umtopfen' ? 'Umtopfen' :
                            care_task.taskType.value
                        %}

                        {% include 'partials/_care_task_card.html.twig' with {
                            task: {
                                id: care_task.id,
                                type: typeLabel,
                                plant: care_task.plant.name,
                                dueDate: care_task.dueDate,
                                href: path('app_task_assignments_show', {'id': item.assignment.id}),
                                currentResponsible: item.currentResponsible.displayname ?: item.currentResponsible.username,
                                originalResponsible: item.originalResponsible.displayname ?: item.originalResponsible.username,
                                received: true,
                                transferredFrom: item.assignment.fromUser.displayname ?: item.assignment.fromUser.username
                            },
                            showDoneButton: item.canComplete
                        } %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <section class="mt-8">
            {% include 'utils/_calender_filter.html.twig' %}
        </section>

        {% if care_task_items is empty %}
            <section class="mt-8 rounded-[2rem] bg-surface-container-lowest p-10 text-center shadow-[0px_20px_50px_rgba(46,52,51,0.04)]">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary-container text-primary">
                    <span class="material-symbols-outlined text-[30px]">event_available</span>
                </div>
                <h2 class="mt-5 text-2xl font-bold text-on-surface">Keine Aufgaben im gewählten Zeitraum</h2>
                <p class="mt-3 text-sm text-on-surface-variant">
                    Sobald neue Care Tasks anstehen, erscheinen sie hier automatisch im Kalender.
                </p>
            </section>
        {% else %}

            {# Tagesansicht #}
            {% if interval == 'Tag' %}
                <section class="mt-8 space-y-4">
                    {% for item in care_task_items %}
                        {% set care_task = item.task %}
                        {% set typeLabel =
                            care_task.taskType.value == 'gießen' ? 'Gießen' :
                            care_task.taskType.value == 'düngen' ? 'Düngen' :
                            care_task.taskType.value == 'umtopfen' ? 'Umtopfen' :
                            care_task.taskType.value
                        %}

                        {% include 'partials/_care_task_card.html.twig' with {
                            task: {
                                id: care_task.id,
                                type: typeLabel,
                                plant: care_task.plant.name,
                                plantId: care_task.plant.id,
                                dueDate: care_task.dueDate,
                                href: item.assignment ? path('app_task_assignments_show', {'id': item.assignment.id}) : path('app_plants_show', {'id': care_task.plant.id}),
                                currentResponsible: item.currentResponsible.displayname ?: item.currentResponsible.username,
                                originalResponsible: item.originalResponsible.displayname ?: item.originalResponsible.username,
                                received: item.received,
                                transferredFrom: item.received and item.assignment ? item.assignment.fromUser.displayname ?: item.assignment.fromUser.username : null,
                                transferredTo: not item.received and item.assignment ? item.assignment.toUser.displayname ?: item.assignment.toUser.username : null
                            },
                            showDoneButton: item.canComplete
                        } %}
                    {% endfor %}
                </section>

            {# Wochenansicht #}
            {% elseif interval == 'Woche' %}
                <section class="mt-8 overflow-hidden rounded-[2rem] bg-surface-container-lowest shadow-[0px_20px_50px_rgba(46,52,51,0.05)]">
                    <div class="overflow-x-auto">
                        <div class="grid min-w-[980px] grid-cols-7 divide-x divide-outline-variant/15">
                            {% for dayOffset in 0..6 %}
                                {% set currentDay = weekStart|date_modify('+' ~ dayOffset ~ ' day') %}
                                {% set currentDayKey = currentDay|date('Y-m-d') %}
                                {% set dayTasks = tasksByDay[currentDayKey]|default([]) %}

                                <div class="min-h-[26rem] bg-surface-container-lowest">
                                    <div class="border-b border-outline-variant/15 px-4 py-4">
                                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-on-surface-variant">{{ currentDay|date('D') }}</p>
                                        <div class="mt-2 flex items-end justify-between gap-3">
                                            <p class="text-2xl font-extrabold text-on-surface">{{ currentDay|date('d') }}</p>
                                            {% if currentDayKey == todayKey %}
                                                <span class="rounded-full bg-primary px-3 py-1 text-xs font-semibold text-on-primary">Heute</span>
                                            {% endif %}
                                        </div>
                                    </div>

                                    <div class="space-y-3 p-4">
                                        {% for item in dayTasks %}
                                            {% set care_task = item.task %}
                                            {% set taskStyle = taskTypeStyles[care_task.taskType.value]|default({
                                                icon: 'local_florist',
                                                accent: 'text-on-surface-variant',
                                                surface: 'bg-surface-container-high'
                                            }) %}
                                            {% set isOverdue = care_task.dueDate|date('U') < nowTs and currentDayKey != todayKey %}

                                            <a href="{{ item.assignment ? path('app_task_assignments_show', {'id': item.assignment.id}) : path('app_plants_show', {'id': care_task.plant.id}) }}"
                                               class="block rounded-3xl border border-transparent bg-surface px-4 py-4 shadow-[0px_12px_30px_rgba(46,52,51,0.04)] transition-all hover:border-primary-fixed">
                                                <div class="flex items-center gap-3">
                                                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl {{ taskStyle.surface }} {{ taskStyle.accent }}">
                                                        <span class="material-symbols-outlined text-[22px]">{{ taskStyle.icon }}</span>
                                                    </div>
                                                    <div class="min-w-0">
                                                        <p class="truncate text-sm font-bold text-on-surface">{{ care_task.taskType.value }}</p>
                                                        <p class="truncate text-xs text-on-surface-variant">{{ care_task.plant.name }}</p>
                                                    </div>
                                                </div>
                                                <div class="mt-3 flex items-center justify-between gap-3 text-xs font-medium">
                                                    <span class="text-on-surface-variant">{{ care_task.dueDate|date('H:i') }} Uhr</span>
                                                    {% if isOverdue %}
                                                        <span class="rounded-full bg-error-container px-2.5 py-1 text-on-error-container">Überfällig</span>
                                                    {% endif %}
                                                </div>
                                                <p class="mt-2 truncate text-xs text-on-surface-variant">
                                                    Verantwortlich: {{ item.currentResponsible.displayname ?: item.currentResponsible.username }}
                                                </p>
                                            </a>
                                        {% else %}
                                            <div class="rounded-3xl border border-dashed border-outline-variant/20 px-4 py-8 text-center text-sm text-on-surface-variant">
                                                Keine Aufgaben
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </section>

            {# Montasansicht #}
            {% else %}
                <section class="mt-8 overflow-hidden rounded-[2rem] bg-surface-container-lowest shadow-[0px_20px_50px_rgba(46,52,51,0.05)]">
                    <div class="flex items-center justify-between border-b border-outline-variant/15 px-6 py-5">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-on-surface-variant">Monatskalender</p>
                            <h2 class="mt-1 text-2xl font-bold text-on-surface">{{ monthStart|date('F Y') }}</h2>
                        </div>
                        <p class="text-sm text-on-surface-variant">
                            {{ monthStart|date('d.m.') }} bis {{ monthEnd|date('d.m.Y') }}
                        </p>
                    </div>

                    <div class="grid grid-cols-7 border-b border-outline-variant/15 bg-surface-container-low text-center text-xs font-semibold uppercase tracking-[0.2em] text-on-surface-variant">
                        {% for weekday in ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'] %}
                            <div class="px-2 py-4">{{ weekday }}</div>
                        {% endfor %}
                    </div>

                    <div class="grid grid-cols-7">
                        {% if leadingEmptyDays > 0 %}
                            {% for _ in 1..leadingEmptyDays %}
                                <div class="min-h-40 border-b border-r border-outline-variant/10 bg-surface-container-low/50"></div>
                            {% endfor %}
                        {% endif %}

                        {% for dayNumber in 1..daysInMonth %}
                            {% set cellDate = date(monthStart|date('Y-m-') ~ dayNumber) %}
                            {% set cellDateKey = cellDate|date('Y-m-d') %}
                            {% set dayTasks = tasksByDay[cellDateKey]|default([]) %}

                            <div class="min-h-40 border-b border-r border-outline-variant/10 p-3 align-top">
                                <div class="mb-3 flex items-center justify-between gap-2">
                                    <span class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold {{ cellDateKey == todayKey ? 'bg-primary text-on-primary' : 'text-on-surface' }}">
                                        {{ dayNumber }}
                                    </span>
                                    {% if dayTasks|length > 0 %}
                                        <span class="rounded-full bg-surface-container px-2.5 py-1 text-[11px] font-semibold text-on-surface-variant">
                                            {{ dayTasks|length }} Task{{ dayTasks|length > 1 ? 's' : '' }}
                                        </span>
                                    {% endif %}
                                </div>

                                <div class="space-y-2">
                                    {% for item in dayTasks|slice(0, 3) %}
                                        {% set care_task = item.task %}
                                        {% set taskStyle = taskTypeStyles[care_task.taskType.value]|default({
                                            icon: 'local_florist',
                                            accent: 'text-on-surface-variant',
                                            surface: 'bg-surface-container-high'
                                        }) %}
                                        <a href="{{ item.assignment ? path('app_task_assignments_show', {'id': item.assignment.id}) : path('app_plants_show', {'id': care_task.plant.id}) }}"
                                           class="flex items-center gap-2 rounded-2xl bg-surface px-3 py-2 text-sm shadow-[0px_10px_24px_rgba(46,52,51,0.04)] transition-all hover:translate-y-[-1px]">
                                            <span class="material-symbols-outlined text-[18px] {{ taskStyle.accent }}">{{ taskStyle.icon }}</span>
                                            <span class="min-w-0">
                                                <span class="block truncate font-medium text-on-surface">{{ care_task.plant.name }}</span>
                                                <span class="block truncate text-[11px] text-on-surface-variant">{{ item.currentResponsible.displayname ?: item.currentResponsible.username }}</span>
                                            </span>
                                        </a>
                                    {% endfor %}

                                    {% if dayTasks|length > 3 %}
                                        <div class="rounded-2xl bg-surface-container px-3 py-2 text-xs font-semibold text-on-surface-variant">
                                            +{{ dayTasks|length - 3 }} weitere Aufgaben
                                        </div>
                                    {% elseif dayTasks is empty %}
                                        <div class="rounded-2xl border border-dashed border-outline-variant/20 px-3 py-4 text-center text-xs text-on-surface-variant">
                                            Frei
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        {% endif %}
    </main>
{% endblock %}
