<!DOCTYPE html>

<html class="light" lang="en">
    <head>

        <title>{% block title%}Florena {% endblock %}</title>
        <meta charset="utf-8"/>
        <meta content="width=device-width, initial-scale=1.0" name="viewport"/>

        {{ importmap('app') }}

        <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;family=Inter:wght@300;400;500;600&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
        <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            "primary-fixed-dim": "#abe56e",
                            "on-secondary-container": "#4b553e",
                            "surface-container-highest": "#dee4e2",
                            "surface-container-high": "#e5e9e8",
                            "on-error": "#fff7f6",
                            "on-tertiary": "#fff8e9",
                            "primary": "#3d6b00",
                            "outline": "#767c7b",
                            "inverse-primary": "#befa7f",
                            "inverse-on-surface": "#9b9d9d",
                            "on-error-container": "#6e1400",
                            "on-tertiary-fixed": "#4f4611",
                            "surface-variant": "#dee4e2",
                            "surface-container-low": "#f2f4f3",
                            "on-primary": "#eeffd6",
                            "on-primary-fixed": "#274800",
                            "error-dim": "#791903",
                            "error": "#a73b21",
                            "inverse-surface": "#0c0f0e",
                            "surface-tint": "#3d6b00",
                            "on-tertiary-fixed-variant": "#6d632b",
                            "on-secondary-fixed-variant": "#545f47",
                            "on-tertiary-container": "#625922",
                            "on-surface": "#2e3433",
                            "primary-dim": "#345d00",
                            "tertiary-dim": "#5d531d",
                            "surface-container-lowest": "#ffffff",
                            "tertiary-fixed": "#fdefa8",
                            "primary-container": "#b8f47a",
                            "surface": "#f9f9f8",
                            "tertiary-container": "#fdefa8",
                            "secondary-dim": "#4c573f",
                            "surface-bright": "#f9f9f8",
                            "secondary-fixed-dim": "#cdd9bb",
                            "on-surface-variant": "#5a6060",
                            "on-background": "#2e3433",
                            "tertiary": "#695f28",
                            "on-secondary": "#f1fdde",
                            "error-container": "#fd795a",
                            "secondary": "#58634a",
                            "on-primary-container": "#335c00",
                            "primary-fixed": "#b8f47a",
                            "tertiary-fixed-dim": "#efe09b",
                            "secondary-fixed": "#dbe7c8",
                            "surface-dim": "#d6dbda",
                            "outline-variant": "#adb3b2",
                            "on-primary-fixed-variant": "#3a6700",
                            "surface-container": "#ebefed",
                            "secondary-container": "#dbe7c8",
                            "on-secondary-fixed": "#38432d",
                            "background": "#f9f9f8"
                        },
                        fontFamily: {
                            "headline": ["Plus Jakarta Sans"],
                            "body": ["Inter"],
                            "label": ["Inter"]
                        },
                        borderRadius: {"DEFAULT": "1rem", "lg": "2rem", "xl": "3rem", "full": "9999px"},
                        },
                    },
                }
        </script>
        <style>
            .material-symbols-outlined {
                font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            }
            .editorial-shadow {
                box-shadow: 0px 20px 40px rgba(46, 52, 51, 0.06);
            }
            body {
                background-color: #f9f9f8;
                color: #2e3433;
                -webkit-font-smoothing: antialiased;
            }
        </style>
    </head>
    <body class="min-h-screen flex flex-col font-body selection:bg-primary-container selection:text-on-primary-container">

        {% block header %}{% endblock %}

        {# Flash Messages #}
        {% block messages %}
            {% include 'partials/_flash_messages.html.twig' %}
        {% endblock %}

        <main class="flex-1">
            {% block body %}{% endblock %}
        </main>

        {# Footer #}
        <footer class="w-full py-8">
            <div class="max-w-7xl mx-auto px-8 flex items-center gap-6">
                <a href="{{ path('app_impressum') }}"
                class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors cursor-pointer">
                    Impressum
                </a>

                <a href="{{ path('app_contact') }}"
                class="text-sm font-medium text-on-surface-variant hover:text-primary transition-colors cursor-pointer">
                    Kontakt
                </a>
            </div>
        </footer>
        <style>
            @keyframes bounce-slow {
                0%, 100% { transform: translateY(0); }
                50% { transform: translateY(-10px); }
            }
            .animate-bounce-slow {
                animation: bounce-slow 4s ease-in-out infinite;
            }
        </style>
    </body>
</html>
