{{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

<div class="overflow-hidden rounded-xl bg-surface-container-lowest shadow-[0_20px_40px_rgba(46,52,51,0.06)]">

    <section class="border-b border-surface-container p-8 md:p-12 space-y-10">
        <div class="mb-8 flex items-center gap-3">
            <span class="rounded-lg bg-primary-container p-2 text-on-primary-container">
                <span class="material-symbols-outlined block">favorite</span>
            </span>
            <h2 class="text-2xl font-bold tracking-tight">Wunschpflanze</h2>
        </div>

        <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
            <div class="space-y-6 lg:col-span-7">
                <div class="space-y-2">
                    {{ form_label(form.name, null, {
                        label_attr: {
                            class: 'flex items-center font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.name, {
                        attr: {
                            class: 'w-full rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface placeholder:text-outline-variant transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                            placeholder: 'z.B. Monstera Thai Constellation'
                        }
                    }) }}
                    {{ form_errors(form.name) }}
                </div>

                <div class="space-y-2">
                    {{ form_label(form.botanical_name, null, {
                        label_attr: {
                            class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.botanical_name, {
                        attr: {
                            class: 'w-full rounded-lg border-transparent bg-surface-container-low px-5 py-4 italic text-on-surface placeholder:text-outline-variant transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                            placeholder: 'z.B. Monstera deliciosa'
                        }
                    }) }}
                    {{ form_errors(form.botanical_name) }}
                </div>

                <div class="space-y-2">
                    {{ form_label(form.description, null, {
                        label_attr: {
                            class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.description, {
                        attr: {
                            class: 'w-full resize-none rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface placeholder:text-outline-variant transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                            placeholder: 'Notizen zur Wunschpflanze...',
                            rows: 4
                        }
                    }) }}
                    {{ form_errors(form.description) }}
                </div>
            </div>

            <div class="space-y-6 lg:col-span-5">
                <div class="space-y-2">
                    {{ form_label(form.quantity, null, {
                        label_attr: {
                            class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.quantity, {
                        attr: {
                            class: 'w-full rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface transition-all focus:border-primary focus:ring-4 focus:ring-primary/10',
                            min: 1
                        }
                    }) }}
                    {{ form_errors(form.quantity) }}
                </div>

                <div class="space-y-2">
                    {{ form_label(form.location, null, {
                        label_attr: {
                            class: 'font-label text-xs font-bold uppercase tracking-[0.1em] text-on-surface-variant'
                        }
                    }) }}
                    {{ form_widget(form.location, {
                        attr: {
                            class: 'w-full rounded-lg border-transparent bg-surface-container-low px-5 py-4 text-on-surface transition-all focus:border-primary focus:ring-4 focus:ring-primary/10'
                        }
                    }) }}
                    {{ form_errors(form.location) }}
                </div>
            </div>
        </div>
    </section>

</div>

<div class="mt-10 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col items-center justify-end gap-4 md:flex-row">
        <a href="{{ path('app_wishlist_plants_index') }}"
           class="w-full px-10 py-4 text-center font-bold text-on-surface-variant transition-colors hover:text-on-surface md:w-auto">
            Abbrechen
        </a>

        <button type="submit"
                class="flex w-full items-center justify-center gap-2 rounded-full bg-primary px-12 py-4 font-bold text-on-primary shadow-[0_10px_20px_rgba(61,107,0,0.2)] transition-all active:scale-95 md:w-auto">
            <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">save</span>
            {{ button_label|default('Speichern') }}
        </button>
    </div>
</div>

{{ form_widget(form._token) }}
{{ form_widget(form.user) }}
{{ form_end(form, { render_rest: false }) }}
