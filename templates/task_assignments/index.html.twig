{% extends 'base.html.twig' %}

{% block title %}TaskAssignments index{% endblock %}

{% block body %}
    <h1>TaskAssignments index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Von</th>
                <th>Bis</th>
                <th>Übertragen am</th>
                <th>Aktionen</th>
            </tr>
        </thead>
        <tbody>
        {% for task_assignment in task_assignments %}
            <tr>
                <td>{{ task_assignment.startDate ? task_assignment.startDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ task_assignment.endDate ? task_assignment.endDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ task_assignment.assignedAt ? task_assignment.assignedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_task_assignments_show', {'id': task_assignment.id}) }}">anzeigen</a>
                    <a href="{{ path('app_task_assignments_edit', {'id': task_assignment.id}) }}">bearbeiten</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">keine Übertragungen gefunden</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_task_assignments_new') }}">neu</a>
{% endblock %}
