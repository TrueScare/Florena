{% extends 'base.html.twig' %}

{% block title %}Aufgaben übergeben{% endblock %}

{% block header %}
    {% include 'partials/_app_navbar.html.twig' with { active_page: 'care-for-me' } %}
{% endblock %}

{% block body %}
    <main class="mx-auto max-w-3xl px-4 pb-24 pt-28 sm:px-8">
        <div class="mb-6">
            <a class="text-sm font-semibold text-primary hover:text-primary-dim" href="{{ path('app_task_assignments_index') }}">
                Zurück zu Care for Me
            </a>
            <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-primary">Aufgaben übergeben</h1>
            <p class="mt-2 text-sm text-on-surface-variant">
                Wähle einen Zeitraum, eine registrierte Person und die anstehenden Aufgaben in diesem Zeitraum.
            </p>
        </div>

        <section class="rounded-2xl bg-surface-container-lowest p-6 shadow-[0px_12px_30px_rgba(46,52,51,0.05)]">
            {{ include('task_assignments/_form.html.twig') }}
        </section>
    </main>
{% endblock %}
