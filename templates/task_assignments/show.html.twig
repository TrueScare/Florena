{% extends 'base.html.twig' %}

{% block title %}Übergabe{% endblock %}

{% block header %}
    {% include 'partials/_app_navbar.html.twig' with { active_page: 'care-for-me' } %}
{% endblock %}

{% block body %}
    {% set task = task_assignment.careTask %}
    {% set ownerName = task.plant.user.displayname ?: task.plant.user.username %}
    {% set fromName = task_assignment.fromUser.displayname ?: task_assignment.fromUser.username %}
    {% set toName = task_assignment.toUser.displayname ?: task_assignment.toUser.username %}

    <main class="mx-auto max-w-3xl px-4 pb-24 pt-28 sm:px-8">
        <a class="text-sm font-semibold text-primary hover:text-primary-dim" href="{{ path('app_task_assignments_index') }}">
            Zurück zu Care for Me
        </a>

        <section class="mt-6 rounded-2xl bg-surface-container-lowest p-6 shadow-[0px_12px_30px_rgba(46,52,51,0.05)]">
            <h1 class="text-3xl font-extrabold tracking-tight text-primary">Übergabe</h1>
            <p class="mt-2 text-on-surface">{{ task.plant.name }} · {{ task.taskType.value|capitalize }}</p>

            <dl class="mt-6 grid gap-3 text-sm">
                <div class="flex justify-between gap-4 border-b border-outline-variant/20 pb-3">
                    <dt class="text-on-surface-variant">Zeitraum</dt>
                    <dd class="font-semibold text-on-surface">{{ task_assignment.startDate|date('d.m.Y H:i') }} bis {{ task_assignment.endDate|date('d.m.Y H:i') }}</dd>
                </div>
                <div class="flex justify-between gap-4 border-b border-outline-variant/20 pb-3">
                    <dt class="text-on-surface-variant">Ursprünglich verantwortlich</dt>
                    <dd class="font-semibold text-on-surface">{{ ownerName }}</dd>
                </div>
                <div class="flex justify-between gap-4 border-b border-outline-variant/20 pb-3">
                    <dt class="text-on-surface-variant">Übergeben von</dt>
                    <dd class="font-semibold text-on-surface">{{ fromName }}</dd>
                </div>
                <div class="flex justify-between gap-4 border-b border-outline-variant/20 pb-3">
                    <dt class="text-on-surface-variant">Aktuell verantwortlich</dt>
                    <dd class="font-semibold text-on-surface">{{ toName }}</dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-on-surface-variant">Übertragen am</dt>
                    <dd class="font-semibold text-on-surface">{{ task_assignment.assignedAt|date('d.m.Y H:i') }}</dd>
                </div>
            </dl>
        </section>

        <div class="mt-6 flex items-center gap-4">
            {% if task_assignment.fromUser == app.user %}
                <a class="rounded-full bg-primary px-5 py-3 text-sm font-semibold text-on-primary hover:bg-primary-dim"
                   href="{{ path('app_task_assignments_edit', {'id': task_assignment.id}) }}">
                    Bearbeiten
                </a>
            {% endif %}
            {{ include('task_assignments/_delete_form.html.twig') }}
        </div>
    </main>
{% endblock %}
