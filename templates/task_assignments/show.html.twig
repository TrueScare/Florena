{% extends 'base.html.twig' %}

{% block title %}TaskAssignments{% endblock %}

{% block body %}
    <h1>TaskAssignments</h1>

    <table class="table">
        <tbody>
        <tr>
            <th>Aufgabe(n)</th>
            <td>
                {{ task_assignment.careTask.plant.name }} {{ task_assignment.careTask.taskType.value }} von {{ task_assignment.careTask.plant.user.username }}
            </td>
        </tr>
        <tr>
            <th>Start_date</th>
            <td>{{ task_assignment.startDate ? task_assignment.startDate|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
        <tr>
            <th>End_date</th>
            <td>{{ task_assignment.endDate ? task_assignment.endDate|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
        <tr>
            <th>Assigned_at</th>
            <td>{{ task_assignment.assignedAt ? task_assignment.assignedAt|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
        <tr>
            <th>Responded_at</th>
            <td>{{ task_assignment.respondedAt ? task_assignment.respondedAt|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('app_task_assignments_index') }}">zurück zur Liste</a>

    <a href="{{ path('app_task_assignments_edit', {'id': task_assignment.id}) }}">bearbeiten</a>

    {{ include('task_assignments/_delete_form.html.twig') }}
{% endblock %}
