<form class="w-full md:w-auto" method="post" action="{{ path('app_task_assignments_delete', {'id': task_assignment.id}) }}" onsubmit="return confirm('Bist du sicher, dass du die Aufgabenübertragung löschen möchtest?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task_assignment.id) }}">
    <button class="w-full rounded-full border border-error/30 px-10 py-4 text-center font-bold text-error transition-colors hover:bg-error-container/20 md:w-auto">Löschen</button>
</form>
