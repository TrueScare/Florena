<form method="post" action="{{ path('app_task_assignments_delete', {'id': task_assignment.id}) }}" onsubmit="return confirm('Bist du sicher, dass du die Aufgabenübertragung löschen möchtest?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task_assignment.id) }}">
    <button class="rounded-full border border-error/30 px-5 py-3 text-sm font-semibold text-error hover:bg-error-container/20">Löschen</button>
</form>
