{% set stressBadgeClass = plant.stressLevel >= 80
    ? 'bg-[#E53935]/10 border-[#E53935]/20'
    : (plant.stressLevel >= 40 ? 'bg-[#FFB300]/10 border-[#FFB300]/20' : 'bg-[#7CB342]/10 border-[#7CB342]/20') %}
{% set stressTextClass = plant.stressLevel >= 80
    ? 'text-[#E53935]'
    : (plant.stressLevel >= 40 ? 'text-[#FFB300]' : 'text-[#7CB342]') %}

{% set fitnessStatus = plant.fitnessStatus ?? null %}
{% set fitnessBadgeClass = fitnessStatus == 'geeignet'
    ? 'bg-primary/10 border-primary/20'
    : (fitnessStatus == 'teilweise geeignet' ? 'bg-[#FFB300]/10 border-[#FFB300]/20' : 'bg-[#E53935]/10 border-[#E53935]/20') %}
{% set fitnessTextClass = fitnessStatus == 'geeignet'
    ? 'text-primary'
    : (fitnessStatus == 'teilweise geeignet' ? 'text-[#FFB300]' : 'text-[#E53935]') %}

<a href="{{ path('app_plants_show', { id: plant.id }) }}"
   class="block cursor-pointer transition-transform hover:scale-[1.01]">
    <article class="flex items-center gap-5 rounded-xl border border-transparent bg-surface-container-lowest p-4 shadow-[0px_20px_40px_rgba(46,52,51,0.03)] transition-all hover:border-primary-fixed">
        <div class="h-24 w-24 overflow-hidden rounded-lg">
            <img src="{{ plant.imageUrl }}"
                 alt="{{ plant.imageAlt }}"
                 class="h-full w-full object-cover">
        </div>

        <div class="flex-grow min-w-0">
            <h3 class="text-lg font-bold truncate">{{ plant.name }}</h3>
            {% if plant.botanicalName is defined and plant.botanicalName %}
                <p class="text-sm italic text-on-surface-variant mt-1 truncate">
                    {{ plant.botanicalName }}
                </p>
            {% endif %}
            <p class="text-xs uppercase tracking-widest text-on-surface-variant">
                {{ plant.location }}
            </p>
        </div>

        {% if fitnessStatus %}
            <div class="text-center">
                <div class="rounded-full border px-3 py-1 {{ fitnessBadgeClass }}">
                    <span class="text-xs font-bold {{ fitnessTextClass }}">
                        {{ fitnessStatus }}
                    </span>
                </div>
                <span class="text-[10px] font-bold text-on-surface-variant">
                    EIGNUNG
                </span>
            </div>
        {% endif %}

        <div class="text-center">
            <div class="rounded-full border px-3 py-1 {{ stressBadgeClass }}">
                <span class="text-xs font-bold {{ stressTextClass }}">
                    {{ plant.stressLevel }}%
                </span>
            </div>
            <span class="text-[10px] font-bold text-on-surface-variant">
                STRESS
            </span>
        </div>
    </article>
</a>
