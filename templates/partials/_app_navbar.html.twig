{% set activePage = active_page|default('') %}
{% set navItems = [
    { key: 'dashboard', label: 'Dashboard', route: 'app_dashboard' },
    { key: 'calendar', label: 'Kalender', route: 'app_care_task_index' },
    { key: 'wishlist', label: 'Wunschliste', route: 'app_wishlist_plants_index' },
    { key: 'care-for-me', label: 'Care for Me', route: 'app_task_assignments_index' },
    { key: 'leaderboard', label: 'Leaderboard', route: 'app_leaderboard_index' },
] %}

<header class="fixed top-0 z-50 w-full bg-[#f9f9f8]/95 backdrop-blur-md">
    <div class="mx-auto flex h-20 max-w-screen-2xl items-center justify-between px-8">
        <a href="{{ path('app_dashboard') }}" class="text-2xl font-bold tracking-tight text-[#3d6b00]">
            Florena
        </a>

        {# Navbar #}
        <nav
            class="hidden items-center gap-1 rounded-full border border-outline-variant/10 bg-surface-container-low px-2 py-1.5 shadow-sm md:flex">
            {% for item in navItems %}
                {% set isActive = item.key == activePage %}
                {% set sharedClasses = 'rounded-full px-6 py-2 text-sm transition-all duration-200' %}
                {% if item.route %}
                    <a href="{{ path(item.route) }}"
                       class="{{ sharedClasses }} {{ isActive ? 'bg-primary font-bold text-on-primary shadow-md shadow-primary/20' : 'font-medium text-on-surface-variant hover:text-primary' }}">
                        {{ item.label }}
                    </a>
                {% else %}
                    <span
                        class="{{ sharedClasses }} {{ isActive ? 'bg-primary font-bold text-on-primary shadow-md shadow-primary/20' : 'cursor-default font-medium text-on-surface-variant/70' }}">
                        {{ item.label }}
                    </span>
                {% endif %}
            {% endfor %}
        </nav>

        {# Mobile Navbar #}
        <div class="flex items-center gap-4">

            <div data-controller="mobile-nav" class="relative md:hidden">
                <button
                    type="button"
                    data-action="click->mobile-nav#toggle"
                    class="rounded-full border border-outline-variant/20 p-2.5 text-primary transition-all duration-300 hover:bg-primary-container"
                    aria-label="Navigation öffnen"
                >
                    <span class="material-symbols-outlined">menu</span>
                </button>

                <div
                    data-mobile-nav-target="dropdown"
                    class="hidden absolute right-0 z-50 mt-3 w-56 rounded-xl border border-surface-container-high bg-surface-container-lowest p-2 shadow-[0px_20px_40px_rgba(46,52,51,0.12)]"
                >
                    {% for item in navItems %}
                        {% set isActive = item.key == activePage %}

                        {% if item.route %}
                            <a
                                href="{{ path(item.route) }}"
                                data-action="click->mobile-nav#close"
                                class="flex items-center rounded-lg px-4 py-3 text-sm transition-colors {{ isActive ? 'bg-[#3d6b00]/10 font-bold text-[#3d6b00]' : 'text-on-surface-variant hover:bg-surface-container-low hover:text-primary' }}"
                            >
                                {{ item.label }}
                            </a>
                        {% else %}
                            <span
                                aria-disabled="true"
                                class="flex cursor-not-allowed items-center rounded-lg px-4 py-3 text-sm text-on-surface-variant/50"
                            >
                                {{ item.label }}
                            </span>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            
            {# Notifications #}
            <div data-controller="notifications" class="relative">
                <button
                    type="button"
                    data-action="click->notifications#toggle"
                    class="relative rounded-full p-2.5 text-primary transition-all duration-300 hover:bg-primary-container"
                    aria-label="Benachrichtigungen öffnen"
                >
                    <span class="material-symbols-outlined">notifications</span>

                    <span
                        data-notifications-target="badge"
                        class="hidden absolute right-1 top-1 h-2.5 w-2.5 rounded-full bg-error"
                    ></span>
                </button>

                <div
                    data-notifications-target="dropdown"
                    class="hidden absolute right-0 z-50 mt-3 w-80 rounded-xl border border-surface-container-high bg-surface-container-lowest p-2 shadow-[0px_20px_40px_rgba(46,52,51,0.12)]"
                >
                    <p class="p-3 text-sm text-on-surface-variant">Lade...</p>
                </div>
            </div>

            {# User Dropdown #}
            {% if app.user %}
                {% set minimalModeEnabled = app.user.minimalMode %}
                <div data-controller="user-menu" class="relative">
                    <button
                        type="button"
                        data-user-menu-target="button"
                        data-action="click->user-menu#toggle"
                        class="rounded-full border border-outline-variant/20 p-2.5 text-primary transition-all duration-300 hover:bg-primary-container"
                        aria-label="Benutzermenü öffnen"
                        aria-expanded="false"
                        >
                        <span class="material-symbols-outlined">account_circle</span>
                    </button>

                    {# Userdaten #}
                    <div
                        data-user-menu-target="dropdown"
                        class="hidden absolute right-0 z-50 mt-3 w-80 rounded-xl border border-surface-container-high bg-surface-container-lowest p-2 shadow-[0px_20px_40px_rgba(46,52,51,0.12)]"
                        >
                        <div class="border-b border-surface-container-high px-4 py-3">
                            <p class="text-sm font-semibold text-on-surface">
                                {{ app.user.displayname ?: app.user.username }}
                            </p>
                            <p class="text-xs text-on-surface-variant">
                                {{ app.user.email }}
                            </p>
                        </div>

                        {# Minimalismus-Modus #}
                        <div class="px-4 py-3">
                            <div class="flex items-center justify-between gap-4">
                                <div>
                                    <p class="text-sm font-semibold text-on-surface">Minimalismus-Modus</p>
                                    <p class="mt-1 text-xs leading-5 text-on-surface-variant">
                                        Reduziert die Anzeige auf die wichtigsten anstehenden Aufgaben.
                                    </p>
                                </div>

                                <button
                                    type="button"
                                    role="switch"
                                    aria-checked="{{ minimalModeEnabled ? 'true' : 'false' }}"
                                    data-user-menu-target="switch"
                                    data-action="click->user-menu#toggleMinimalMode"
                                    class="{{ minimalModeEnabled ? 'bg-primary' : 'bg-outline-variant' }} relative h-7 w-12 shrink-0 rounded-full transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
                                    >
                                    <span
                                        data-user-menu-thumb
                                        class="{{ minimalModeEnabled ? 'translate-x-5' : '' }} absolute left-1 top-1 h-5 w-5 rounded-full bg-white shadow-sm transition-transform duration-200"
                                    ></span>
                                    <span class="sr-only">Minimalismus-Modus umschalten</span>
                                </button>
                            </div>

                            <p data-user-menu-target="status" class="hidden mt-3 text-xs"></p>
                        </div>

                        {# Logout #}
                        <a
                            href="{{ logout_path() }}"
                            class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-medium text-on-surface-variant transition-colors hover:bg-surface-container-low hover:text-primary"
                            >
                            <span class="material-symbols-outlined text-base">logout</span>
                            Logout
                        </a>
                    </div>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}"
                   class="rounded-full border border-outline-variant/20 p-2.5 text-primary transition-all duration-300 hover:bg-primary-container"
                   aria-label="Einloggen">
                    <span class="material-symbols-outlined">account_circle</span>
                </a>
            {% endif %}
        </div>
    </div>
</header>
