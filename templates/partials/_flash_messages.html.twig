{% if app.session.flashbag.peekAll()|length > 0 %}
    {% set flashClasses = {
        success: 'border-primary bg-primary text-on-primary shadow-[0px_20px_40px_rgba(61,107,0,0.15)]',
        error: 'border-error/20 bg-error-container text-on-error-container',
        warning: 'border-tertiary/20 bg-tertiary-container text-on-tertiary-container',
        info: 'border-outline-variant bg-surface-container text-on-surface',
        verify_email_error: 'border-error/20 bg-error-container text-on-error-container'
    } %}

    <div
        data-controller="flash-messages"
        data-flash-messages-timeout-value="5000"
        class="relative z-40 mx-auto w-full max-w-screen-2xl px-8 pt-24"
    >
        <div class="flex flex-col gap-3">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div
                        data-flash-messages-target="message"
                        class="flex items-start justify-between gap-4 rounded-2xl border px-4 py-3 text-sm font-medium shadow-sm transition-all duration-300 {{ flashClasses[label]|default(flashClasses.info) }}"
                    >
                        <span class="flex-1">
                            {{ message }}
                        </span>

                        <button
                            type="button"
                            data-action="click->flash-messages#close"
                            class="shrink-0 rounded-full p-1 transition-colors hover:bg-black/10"
                            aria-label="Meldung schließen"
                        >
                            <span class="material-symbols-outlined text-base">close</span>
                        </button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </div>
{% endif %}
